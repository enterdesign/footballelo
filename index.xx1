const COUNTRY_COLORS = {
  AUT:"#ED2939",
  AZE:"#0092BC",
  BEL:"#2a2a2a",
  BLR:"#CF101A",
  BUL:"#00966E",
  CRO:"#c0392b",
  CYP:"#4E3629",
  CZE:"#D7141A",
  DEN:"#C60C30",
  ENG:"#C8102E",
  ESP:"#AA151B",
  FIN:"#003580",
  FRA:"#002395",
  GER:"#2a2a2a",
  GRE:"#0D5EAF",
  HUN:"#CE2939",
  ISR:"#0038B8",
  ITA:"#009246",
  KAZ:"#00AFCA",
  MDA:"#003DA5",
  NED:"#FF4F00",
  NOR:"#EF2B2D",
  POL:"#DC143C",
  POR:"#006600",
  ROU:"#002B7F",
  RUS:"#0033A0",
  SCO:"#005EB8",
  SRB:"#C6363C",
  SUI:"#c0392b",
  SVK:"#0B4EA2",
  SVN:"#003DA5",
  SWE:"#006AA7",
  TUR:"#E30A17",
  UKR:"#005BBB",
};


// ── Load matches from server ──────────────────────────────────────
let ranked=[], history=[], seasons=[], allTeamsSorted=[];
let statsChart=null, compareChart=null;
const COLOR_A="#fbbf24", COLOR_B="#60a5fa";

async function loadAndRender() {
  const paths = ['matches.json', './matches.json', '/UCL/matches.json'];
  let lastError = '';
  for (const path of paths) {
    try {
      const resp = await fetch(path + '?v=' + Date.now());
      if (!resp.ok) { lastError = 'HTTP ' + resp.status + ' (' + path + ')'; continue; }
      const matches = await resp.json();
      initApp(matches);
      return;
    } catch(e) { lastError = e.message + ' (' + path + ')'; }
  }
  document.getElementById("hero-sub").textContent = "Cannot load matches.json — " + lastError;
  console.error("loadAndRender failed:", lastError);
}

function initApp(matches) {
  const result = computeElo(matches);
  ranked = result.ranked;
  history = result.history;
  seasons = [...new Set(matches.map(m=>m.season))];
  allTeamsSorted = ranked.map(r=>r.team).sort((a,b)=>a.localeCompare(b));

  // Hero
  document.getElementById("stat-seasons").textContent = seasons.length;
  document.getElementById("stat-matches").textContent = matches.length.toLocaleString();
  document.getElementById("stat-clubs").textContent   = ranked.length;
  document.getElementById("hero-sub").textContent     = "1992/93 – 2025/26  ·  "+seasons.length+" seasons  ·  "+ranked.length+" clubs ranked";

  // Populate selects
  const selSeason = document.getElementById("hist-filter");
  selSeason.innerHTML = '<option value="">All seasons</option>';
  [...seasons].reverse().forEach(s=>{const o=document.createElement("option");o.value=s;o.textContent=s;selSeason.appendChild(o);});

  ["hist-team-filter","stats-club-select","compare-club-a","compare-club-b"].forEach(id=>{
    const sel=document.getElementById(id);
    const firstOpt=sel.options[0].outerHTML;
    sel.innerHTML=firstOpt;
    allTeamsSorted.forEach(t=>{const o=document.createElement("option");o.value=t;o.textContent=t;sel.appendChild(o);});
  });

  // Admin datalist
  const dl=document.getElementById("adm-teams-list");
  allTeamsSorted.forEach(t=>{const o=document.createElement("option");o.value=t;dl.appendChild(o);});
  // Pre-fill season
  if(seasons.length) document.getElementById("adm-season").value=seasons[seasons.length-1];

  // Country chips
  buildChips();
  renderRanking();
  renderHistory();
}

// ── ELO engine ────────────────────────────────────────────────────
function computeElo(matches) {
  const elo={}, matchCount={}, hist=[];
  function get(t){if(!(t in elo))elo[t]=INITIAL_ELO;return elo[t];}
  for(const m of matches){
    const ph=PHASES[m.phase];if(!ph)continue;
    const rA=get(m.teamA),rB=get(m.teamB);
    const eA=1/(1+Math.pow(10,(rB-rA)/400));
    const sA=m.goalsA>m.goalsB?1:m.goalsA===m.goalsB?.5:0;
    const dA=Math.round(ph.k*(sA-eA));
    const bA=rA,bB=rB;
    elo[m.teamA]=rA+dA; elo[m.teamB]=rB-dA;
    matchCount[m.teamA]=(matchCount[m.teamA]||0)+1;
    matchCount[m.teamB]=(matchCount[m.teamB]||0)+1;
    hist.push({...m,before:{[m.teamA]:bA,[m.teamB]:bB},after:{[m.teamA]:elo[m.teamA],[m.teamB]:elo[m.teamB]}});
  }
  const r=Object.entries(elo).map(([team,e])=>{return{team,elo:Math.round(e),matches:matchCount[team]||0};}).sort((a,b)=>b.elo-a.elo);
  return{ranked:r,history:hist};
}

// ── Parallax ─────────────────────────────────────────────────────
window.addEventListener("scroll",()=>{
  const el=document.getElementById("hero-bg");
  if(el) el.style.transform="translateY("+Math.round(window.scrollY*0.35)+"px)";
});

// ── Country chips ─────────────────────────────────────────────────
let activeCountry="";
function buildChips(){
  const codeToCountry={};
  Object.values(TEAM_INFO).forEach(({code,country})=>codeToCountry[code]=country);
  const allCodes=[...new Set(ranked.map(r=>(TEAM_INFO[r.team]||{}).code).filter(Boolean))].sort();
  const wrap=document.getElementById("country-filters");
  wrap.innerHTML="";
  function makeChip(label,country){
    const btn=document.createElement("button");
    btn.className="country-chip"+(country===""?" active":"");
    btn.dataset.country=country;
    btn.textContent=label;
    btn.onclick=()=>{
      activeCountry=country;
      wrap.querySelectorAll(".country-chip").forEach(c=>c.classList.remove("active"));
      btn.classList.add("active");
      renderRanking();
    };
    return btn;
  }
  wrap.appendChild(makeChip("ALL",""));
  allCodes.forEach(code=>wrap.appendChild(makeChip(code,codeToCountry[code]||code)));
}

// ── ELO colour ────────────────────────────────────────────────────
function eloColorHex(e){
  if(e>=1750)return"#fbbf24";if(e>=1700)return"#f97316";
  if(e>=1650)return"#60a5fa";if(e>=1600)return"#4ade80";
  return"#f87171";
}

// ── Ranking ───────────────────────────────────────────────────────
function renderRanking(){
  const container=document.getElementById("ranking-table");
  container.innerHTML="";
  const toShow=activeCountry?ranked.filter(r=>(TEAM_INFO[r.team]||{}).country===activeCountry):ranked;
  if(!toShow.length){container.innerHTML='<div class="empty">NO CLUBS FOUND</div>';return;}
  const globalRank={};ranked.forEach((r,i)=>globalRank[r.team]=i+1);
  const maxElo=toShow[0].elo,minElo=toShow[toShow.length-1].elo;
  toShow.forEach((item,i)=>{
    const info=TEAM_INFO[item.team]||{};
    const code=info.code||"";
    const ccol=COUNTRY_COLORS[code]||"#4a5568";
    const delta=item.elo-INITIAL_ELO;
    const col=eloColorHex(item.elo);
    const barPct=maxElo===minElo?100:Math.max(0,((item.elo-minElo)/(maxElo-minElo))*100);
    const pos=activeCountry?globalRank[item.team]:i+1;
    const rowClass=i===0&&!activeCountry?"rank-row top1":i<3&&!activeCountry?"rank-row top3":"rank-row";
    let medal;
    if(!activeCountry&&i===0) medal=`<span class="rank-badge medal-1">${pos}</span>`;
    else if(!activeCountry&&i===1) medal=`<span class="rank-badge medal-2">${pos}</span>`;
    else if(!activeCountry&&i===2) medal=`<span class="rank-badge medal-3">${pos}</span>`;
    else medal=`<span class="rank-badge medal-n">${pos}</span>`;
    const row=document.createElement("div");
    row.className=rowClass; row.style.cursor="pointer";
    row.title="View history for "+item.team;
    row.addEventListener("click",()=>{
      document.getElementById("hist-team-filter").value=item.team;
      document.getElementById("hist-filter").value="";
      document.getElementById("stats-club-select").value=item.team;
      renderHistory(); renderStats();
      const btn=document.querySelector('.tab-btn[onclick*="history"]');
      if(btn){switchTab("history",btn);}
    });
    row.innerHTML=
      medal+
      `<span class="rank-badge" style="background:${ccol}22;color:${ccol};border:1px solid ${ccol}44">${code}</span>`+
      `<div><div class="rank-name">${item.team}</div>${!activeCountry?`<div class="rank-country-name">${info.country||""}</div>`:""}</div>`+
      `<span class="rank-elo" style="color:${col}">${item.elo}</span>`+
      `<span class="rank-delta" style="color:${delta>=0?"#4ade80":"#f87171"}">${delta>=0?"+":""}${delta}</span>`+
      `<div class="rank-bar-wrap"><div class="rank-bar" style="width:${barPct}%;background:${col}"></div></div>`+
      `<span class="rank-matches">${item.matches}</span>`;
    container.appendChild(row);
  });
}

// ── History ───────────────────────────────────────────────────────
function renderHistory(){
  const teamVal=document.getElementById("hist-team-filter").value;
  const seasonVal=document.getElementById("hist-filter").value;
  const container=document.getElementById("hist-list");
  container.innerHTML="";
  let filtered=history;
  if(seasonVal) filtered=filtered.filter(m=>m.season===seasonVal);
  if(teamVal)   filtered=filtered.filter(m=>m.teamA===teamVal||m.teamB===teamVal);
  if(!filtered.length){container.innerHTML='<div class="empty">NO MATCHES FOUND</div>';return;}
  const grouped={};
  [...filtered].reverse().forEach(m=>{(grouped[m.season]=grouped[m.season]||[]).push(m);});
  Object.keys(grouped).sort((a,b)=>b.localeCompare(a)).forEach(s=>{
    const div=document.createElement("div");div.className="season-divider";div.textContent=s;container.appendChild(div);
    grouped[s].forEach(m=>{
      const ph=PHASES[m.phase]||{label:m.phase,color:"#666"};
      const dA=m.after[m.teamA]-m.before[m.teamA],dB=m.after[m.teamB]-m.before[m.teamB];
      const clA=m.goalsA>m.goalsB?"win":m.goalsA===m.goalsB?"draw":"loss";
      const clB=m.goalsB>m.goalsA?"win":m.goalsA===m.goalsB?"draw":"loss";
      const iA=TEAM_INFO[m.teamA]||{},iB=TEAM_INFO[m.teamB]||{};
      const cA=COUNTRY_COLORS[iA.code]||"#4a5568",cB=COUNTRY_COLORS[iB.code]||"#4a5568";
      const row=document.createElement("div");row.className="hist-row";
      row.innerHTML=
        `<div><span class="badge" style="background:${ph.color}1a;color:${ph.color}">${ph.label}</span></div>`+
        `<div class="hist-team"><div class="hist-team-name"><span class="rank-badge" style="font-size:8px;padding:2px 5px;background:${cA}22;color:${cA};border:1px solid ${cA}44">${iA.code||"·"}</span><span class="${clA}">${m.teamA}</span></div><span class="hist-elo-diff">${dA>=0?"+":""}${dA} (${m.after[m.teamA]})</span></div>`+
        `<div class="hist-score">${m.goalsA} – ${m.goalsB}</div>`+
        `<div class="hist-team"><div class="hist-team-name"><span class="rank-badge" style="font-size:8px;padding:2px 5px;background:${cB}22;color:${cB};border:1px solid ${cB}44">${iB.code||"·"}</span><span class="${clB}">${m.teamB}</span></div><span class="hist-elo-diff">${dB>=0?"+":""}${dB} (${m.after[m.teamB]})</span></div>`;
      container.appendChild(row);
    });
  });
}

// ── Stats ─────────────────────────────────────────────────────────
function renderStats(){
  const club=document.getElementById("stats-club-select").value;
  const emptyEl=document.getElementById("stats-empty");
  const chartWrap=document.getElementById("stats-chart-wrap");
  const gridEl=document.getElementById("stats-season-grid");
  const infoEl=document.getElementById("stats-club-info");
  if(!club){emptyEl.style.display="block";chartWrap.style.display="none";gridEl.style.display="none";infoEl.textContent="";return;}
  emptyEl.style.display="none";
  const timeline=[];
  history.forEach(m=>{
    if(m.teamA===club||m.teamB===club){
      const isA=m.teamA===club;
      timeline.push({elo:isA?m.after[m.teamA]:m.after[m.teamB],season:m.season,phase:m.phase,phaseLabel:(PHASES[m.phase]||{}).label||m.phase,opponent:isA?m.teamB:m.teamA});
    }
  });
  if(!timeline.length){emptyEl.textContent="NO DATA FOR "+club.toUpperCase();emptyEl.style.display="block";chartWrap.style.display="none";gridEl.style.display="none";return;}
  const peakElo=Math.max(...timeline.map(t=>t.elo));
  const peakIdx=timeline.findIndex(t=>t.elo===peakElo);
  const peakSeason=timeline[peakIdx]?.season||"";
  const curElo=timeline[timeline.length-1].elo;
  const globalPos=ranked.findIndex(r=>r.team===club)+1;
  const info=TEAM_INFO[club]||{};
  infoEl.innerHTML=`<span style="color:#fbbf24;font-weight:700">#${globalPos}</span> &nbsp;${info.country||""} &nbsp;·&nbsp; <span style="color:${eloColorHex(curElo)}">${curElo} ELO</span> &nbsp;·&nbsp; ${timeline.length} matches`;
  chartWrap.style.display="block";
  const labels=timeline.map((t,i)=>{if(i===0)return t.season;if(timeline[i-1].season!==t.season)return t.season;return"";});
  const ctx=document.getElementById("stats-chart").getContext("2d");
  const grad=ctx.createLinearGradient(0,0,0,300);
  grad.addColorStop(0,"rgba(251,191,36,0.25)");grad.addColorStop(1,"rgba(251,191,36,0.01)");
  if(statsChart){statsChart.destroy();statsChart=null;}
  statsChart=new Chart(ctx,{type:"line",data:{labels,datasets:[{label:club,data:timeline.map(t=>t.elo),borderColor:"#fbbf24",borderWidth:2,pointRadius:0,pointHoverRadius:5,pointHoverBackgroundColor:"#fbbf24",fill:true,backgroundColor:grad,tension:0.3},{label:"Base",data:timeline.map(()=>1600),borderColor:"rgba(255,255,255,0.08)",borderWidth:1,borderDash:[4,4],pointRadius:0,fill:false}]},options:{responsive:true,maintainAspectRatio:true,interaction:{mode:"index",intersect:false},plugins:{legend:{display:false},tooltip:{backgroundColor:"#0f1017",borderColor:"#1a1c2e",borderWidth:1,titleColor:"#fbbf24",bodyColor:"#94a3b8",titleFont:{family:"'DM Mono',monospace",size:11},bodyFont:{family:"'DM Mono',monospace",size:11},callbacks:{title:items=>{const t=timeline[items[0].dataIndex];return t.season+" · "+t.phaseLabel;},label:item=>item.datasetIndex===1?null:" ELO: "+item.raw+"  vs "+timeline[item.dataIndex].opponent}}},scales:{x:{ticks:{color:"#4a5568",font:{family:"'DM Mono',monospace",size:9},maxRotation:45,autoSkip:true,maxTicksLimit:20},grid:{color:"rgba(255,255,255,0.04)"},border:{color:"rgba(255,255,255,0.08)"}},y:{ticks:{color:"#4a5568",font:{family:"'DM Mono',monospace",size:10}},grid:{color:"rgba(255,255,255,0.04)"},border:{color:"rgba(255,255,255,0.08)"}}}}});
  gridEl.style.display="grid";gridEl.innerHTML="";
  const banner=document.createElement("div");banner.className="stats-peak-banner";banner.style.gridColumn="1 / -1";
  banner.innerHTML=`Highest ELO Rating: <span class="stats-peak-val">${peakElo}</span> &nbsp; in <span style="color:#e2e8f0">${peakSeason}</span> &nbsp;·&nbsp; Current: <span class="stats-peak-val" style="color:${eloColorHex(curElo)}">${curElo}</span> &nbsp;·&nbsp; Matches: <span style="color:#e2e8f0">${timeline.length}</span>`;
  gridEl.appendChild(banner);
  const seasonStats={},seasonOrder=[];let prev=1600;
  timeline.forEach(t=>{if(!seasonStats[t.season]){seasonStats[t.season]={startElo:prev,endElo:t.elo,matches:0};seasonOrder.push(t.season);}seasonStats[t.season].endElo=t.elo;seasonStats[t.season].matches++;prev=t.elo;});
  seasonOrder.forEach(s=>{seasonStats[s].delta=seasonStats[s].endElo-seasonStats[s].startElo;});
  const allEnd=Object.values(seasonStats).map(s=>s.endElo);
  const maxSE=Math.max(...allEnd),minSE=Math.min(...allEnd);
  seasonOrder.forEach(s=>{
    const sv=seasonStats[s];const col=eloColorHex(sv.endElo);
    const barPct=maxSE===minSE?100:Math.max(5,((sv.endElo-minSE)/(maxSE-minSE))*100);
    const card=document.createElement("div");card.className="stats-season-card";
    card.innerHTML=`<span class="stats-season-label">${s}</span><span class="stats-season-elo" style="color:${col}">${sv.endElo}</span><span class="stats-season-delta" style="color:${sv.delta>=0?"#4ade80":"#f87171"}">${sv.delta>=0?"+":""}${sv.delta}</span><div class="stats-season-bar-wrap"><div class="stats-season-bar" style="width:${barPct}%;background:${col}"></div></div><span class="stats-season-matches">${sv.matches}m</span>`;
    gridEl.appendChild(card);
  });
}

// ── Compare ───────────────────────────────────────────────────────
function getClubTimeline(club){const tl=[];history.forEach(m=>{if(m.teamA===club||m.teamB===club){const isA=m.teamA===club;tl.push({elo:isA?m.after[m.teamA]:m.after[m.teamB],season:m.season,phase:m.phase,opponent:isA?m.teamB:m.teamA});}}); return tl;}
function getSeasonElos(tl){const result={},order=[];let prev=1600;tl.forEach(t=>{if(!result[t.season]){result[t.season]={startElo:prev,endElo:t.elo,matches:0};order.push(t.season);}result[t.season].endElo=t.elo;result[t.season].matches++;prev=t.elo;});order.forEach(s=>{result[s].delta=result[s].endElo-result[s].startElo;});return{bySeason:result,order};}

function renderCompare(){
  const clubA=document.getElementById("compare-club-a").value;
  const clubB=document.getElementById("compare-club-b").value;
  const emptyEl=document.getElementById("compare-empty");
  const chartWrap=document.getElementById("compare-chart-wrap");
  const tableEl=document.getElementById("compare-season-table");
  const badgesEl=document.getElementById("compare-badges");
  if(!clubA||!clubB||clubA===clubB){emptyEl.style.display="block";chartWrap.style.display="none";tableEl.innerHTML="";badgesEl.innerHTML="";emptyEl.textContent=(!clubA||!clubB)?"SELECT TWO CLUBS TO COMPARE":"PLEASE SELECT TWO DIFFERENT CLUBS";return;}
  emptyEl.style.display="none";
  const tlA=getClubTimeline(clubA),tlB=getClubTimeline(clubB);
  if(!tlA.length||!tlB.length){emptyEl.textContent="NO DATA AVAILABLE";emptyEl.style.display="block";return;}
  const infoA=TEAM_INFO[clubA]||{},infoB=TEAM_INFO[clubB]||{};
  const curEloA=tlA[tlA.length-1].elo,curEloB=tlB[tlB.length-1].elo;
  const peakA=Math.max(...tlA.map(t=>t.elo)),peakB=Math.max(...tlB.map(t=>t.elo));
  const rankA=ranked.findIndex(r=>r.team===clubA)+1,rankB=ranked.findIndex(r=>r.team===clubB)+1;
  badgesEl.innerHTML=`<div class="compare-badges-row"><div class="compare-badge" style="background:${COLOR_A}15;border:1px solid ${COLOR_A}40;color:${COLOR_A}"><span style="font-size:16px;font-family:'Bebas Neue',sans-serif;letter-spacing:2px">${clubA}</span><span style="color:#94a3b8">#${rankA} · ${infoA.country||""} · ELO ${curEloA} · Peak ${peakA}</span></div><div class="compare-badge" style="background:${COLOR_B}15;border:1px solid ${COLOR_B}40;color:${COLOR_B}"><span style="font-size:16px;font-family:'Bebas Neue',sans-serif;letter-spacing:2px">${clubB}</span><span style="color:#94a3b8">#${rankB} · ${infoB.country||""} · ELO ${curEloB} · Peak ${peakB}</span></div></div>`;
  const {bySeason:bsA}=getSeasonElos(tlA),{bySeason:bsB}=getSeasonElos(tlB);
  const commonSeasons=seasons.filter(s=>bsA[s]||bsB[s]);
  const dataA=commonSeasons.map(s=>bsA[s]?bsA[s].endElo:null);
  const dataB=commonSeasons.map(s=>bsB[s]?bsB[s].endElo:null);
  chartWrap.style.display="block";
  const ctx2=document.getElementById("compare-chart").getContext("2d");
  const gradA=ctx2.createLinearGradient(0,0,0,300);gradA.addColorStop(0,COLOR_A+"40");gradA.addColorStop(1,COLOR_A+"04");
  const gradB=ctx2.createLinearGradient(0,0,0,300);gradB.addColorStop(0,COLOR_B+"40");gradB.addColorStop(1,COLOR_B+"04");
  if(compareChart){compareChart.destroy();compareChart=null;}
  compareChart=new Chart(ctx2,{type:"line",data:{labels:commonSeasons,datasets:[{label:clubA,data:dataA,borderColor:COLOR_A,borderWidth:2.5,backgroundColor:gradA,fill:true,tension:0.3,pointRadius:3,pointBackgroundColor:COLOR_A,pointHoverRadius:6,spanGaps:true},{label:clubB,data:dataB,borderColor:COLOR_B,borderWidth:2.5,backgroundColor:gradB,fill:true,tension:0.3,pointRadius:3,pointBackgroundColor:COLOR_B,pointHoverRadius:6,spanGaps:true},{label:"Base",data:commonSeasons.map(()=>1600),borderColor:"rgba(255,255,255,0.07)",borderWidth:1,borderDash:[4,4],pointRadius:0,fill:false}]},options:{responsive:true,maintainAspectRatio:true,interaction:{mode:"index",intersect:false},plugins:{legend:{display:true,labels:{color:"#94a3b8",font:{family:"'DM Mono',monospace",size:11},boxWidth:16,padding:16,filter:item=>item.label!=="Base"}},tooltip:{backgroundColor:"#0f1017",borderColor:"#1a1c2e",borderWidth:1,titleColor:"#fbbf24",bodyColor:"#94a3b8",titleFont:{family:"'DM Mono',monospace",size:11},bodyFont:{family:"'DM Mono',monospace",size:11},callbacks:{label:item=>item.dataset.label==="Base"?null:` ${item.dataset.label}: ${item.raw} ELO`}}},scales:{x:{ticks:{color:"#4a5568",font:{family:"'DM Mono',monospace",size:9},maxRotation:45,autoSkip:true,maxTicksLimit:20},grid:{color:"rgba(255,255,255,0.04)"},border:{color:"rgba(255,255,255,0.08)"}},y:{ticks:{color:"#4a5568",font:{family:"'DM Mono',monospace",size:10}},grid:{color:"rgba(255,255,255,0.04)"},border:{color:"rgba(255,255,255,0.08)"}}}}});
  let tableHTML=`<div style="border:1px solid #1a1c2e;border-radius:4px;overflow:hidden;"><table class="compare-table"><thead><tr><th style="text-align:left">Season</th><th style="text-align:center;color:${COLOR_A}">${clubA}</th><th style="text-align:center;color:${COLOR_A}">Δ</th><th style="text-align:center;color:${COLOR_B}">${clubB}</th><th style="text-align:center;color:${COLOR_B}">Δ</th><th style="text-align:center">Higher Ranked</th></tr></thead><tbody>`;
  commonSeasons.forEach(s=>{
    const a=bsA[s],b=bsB[s];
    const eloA=a?a.endElo:null,eloB=b?b.endElo:null;
    const dA=a?a.delta:null,dB=b?b.delta:null;
    const leader=eloA&&eloB?(eloA>eloB?clubA.split(" ")[0]:eloA<eloB?clubB.split(" ")[0]:"="):"—";
    const leaderCol=eloA&&eloB?(eloA>eloB?COLOR_A:eloA<eloB?COLOR_B:"#4a5568"):"#4a5568";
    const cellA=eloA?`<span style="color:${eloColorHex(eloA)};font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:1px">${eloA}</span>`:`<span style="color:#2a2d3e">—</span>`;
    const cellB=eloB?`<span style="color:${eloColorHex(eloB)};font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:1px">${eloB}</span>`:`<span style="color:#2a2d3e">—</span>`;
    const dCellA=dA!==null?`<span style="color:${dA>=0?"#4ade80":"#f87171"}">${dA>=0?"+":""}${dA}</span>`:`<span style="color:#2a2d3e">—</span>`;
    const dCellB=dB!==null?`<span style="color:${dB>=0?"#4ade80":"#f87171"}">${dB>=0?"+":""}${dB}</span>`:`<span style="color:#2a2d3e">—</span>`;
    tableHTML+=`<tr><td class="season-col">${s}</td><td style="text-align:center">${cellA}</td><td style="text-align:center">${dCellA}</td><td style="text-align:center">${cellB}</td><td style="text-align:center">${dCellB}</td><td style="text-align:center;color:${leaderCol};font-weight:600">${leader}</td></tr>`;
  });
  tableHTML+="</tbody></table></div>";
  tableEl.innerHTML=tableHTML;
}

// ── Admin ─────────────────────────────────────────────────────────
function toggleAdmin(){
  const p=document.getElementById("admin-panel");
  p.style.display=p.style.display==="none"||p.style.display===""?"block":"none";
}

async function adminAddMatch(){
  const msg=document.getElementById("admin-msg");
  const goalsARaw=document.getElementById("adm-goalsA").value;
  const goalsBRaw=document.getElementById("adm-goalsB").value;
  const body={
    password: document.getElementById("adm-pass").value,
    season:   document.getElementById("adm-season").value.trim(),
    phase:    document.getElementById("adm-phase").value,
    teamA:    document.getElementById("adm-teamA").value.trim(),
    goalsA:   goalsARaw==="" ? "" : parseInt(goalsARaw,10),
    teamB:    document.getElementById("adm-teamB").value.trim(),
    goalsB:   goalsBRaw==="" ? "" : parseInt(goalsBRaw,10),
  };
  if(!body.teamA||!body.teamB||goalsARaw===""||goalsBRaw===""||!body.season){
    msg.className="err"; msg.textContent="Fill in all fields."; msg.style.display="block"; return;
  }
  msg.className=""; msg.textContent="Saving…"; msg.style.display="block";
  try{
    const r=await fetch("save_match.php",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
    const data=await r.json();
    if(!r.ok){msg.className="err";msg.textContent="Error: "+data.error;return;}
    msg.className="ok";
    msg.textContent=`✓ Saved! Total matches: ${data.total}. Reloading…`;
    setTimeout(()=>loadAndRender(),1200);
  }catch(e){msg.className="err";msg.textContent="Network error: "+e.message;}
}

// ── Tab switch ────────────────────────────────────────────────────
function switchTab(name,btn){
  document.querySelectorAll(".panel").forEach(p=>p.classList.remove("active"));
  document.querySelectorAll(".tab-btn").forEach(b=>b.classList.remove("active"));
  document.getElementById("panel-"+name).classList.add("active");
  btn.classList.add("active");
}


// ── Admin: load recent + delete ───────────────────────────────────
async function adminLoadRecent() {
  const container = document.getElementById("admin-recent");
  container.innerHTML = '<span style="color:#4a5568">Loading…</span>';
  try {
    const resp = await fetch('matches.json?v=' + Date.now());
    if (!resp.ok) throw new Error('HTTP ' + resp.status);
    const matches = await resp.json();
    const recent = matches.slice(-20).reverse(); // last 20, newest first
    if (!recent.length) { container.textContent = "No matches found."; return; }

    const PHASE_LABELS = {group:"GR",r16:"R16",qf:"QF",sf:"SF",final:"FIN"};
    container.innerHTML = "";
    recent.forEach((m, i) => {
      const globalIdx = matches.length - 1 - i; // actual index in full array
      const row = document.createElement("div");
      row.style.cssText = "display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid #111320;";
      row.innerHTML =
        `<span style="color:#fbbf24;min-width:58px;font-size:10px">${m.season}</span>` +
        `<span style="background:#60a5fa1a;color:#60a5fa;padding:2px 5px;border-radius:2px;font-size:9px;min-width:28px;text-align:center">${PHASE_LABELS[m.phase]||m.phase}</span>` +
        `<span style="flex:1;color:#e2e8f0">${m.teamA} <span style="color:#4a5568">${m.goalsA}–${m.goalsB}</span> ${m.teamB}</span>` +
        `<button onclick="adminDelete(${globalIdx}, this)" style="background:none;border:1px solid #2a2d3e;color:#4a5568;font-family:'DM Mono',monospace;font-size:10px;padding:3px 8px;cursor:pointer;border-radius:3px;transition:all .15s;" onmouseover="this.style.borderColor='#ef4444';this.style.color='#ef4444'" onmouseout="this.style.borderColor='#2a2d3e';this.style.color='#4a5568'">✕ delete</button>`;
      container.appendChild(row);
    });
  } catch(e) {
    container.textContent = "Error: " + e.message;
  }
}

async function adminDelete(index, btn) {
  const pass = document.getElementById("adm-pass").value;
  if (!pass) { alert("Enter password first."); return; }
  if (!confirm("Delete this match?")) return;
  btn.textContent = "…";
  btn.disabled = true;
  try {
    const r = await fetch("save_match.php", {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify({password: pass, action: "delete", index})
    });
    const data = await r.json();
    if (!r.ok) { alert("Error: " + data.error); btn.textContent = "✕ delete"; btn.disabled = false; return; }
    const msg = document.getElementById("admin-msg");
    msg.className = "ok"; msg.textContent = "✓ Match deleted. Total: " + data.total; msg.style.display = "block";
    btn.closest("div").remove();
    setTimeout(() => loadAndRender(), 800);
  } catch(e) {
    alert("Network error: " + e.message);
    btn.textContent = "✕ delete"; btn.disabled = false;
  }
}


// ── fbref paste parser ─────────────────────────────────────────────
let parsedMatches = [];

const PHASE_MAP = {
  'league phase':'group', 'group stage':'group',
  'knockout phase play-offs':'r16', 'knockout phase play-off':'r16',
  'round of 16':'r16', 'round of 32':'r16',
  'quarter-finals':'qf', 'quarter-final':'qf',
  'semi-finals':'sf', 'semi-final':'sf',
  'final':'final',
};

function parsePhase(str) {
  const s = str.toLowerCase().trim();
  for (const [key, val] of Object.entries(PHASE_MAP)) {
    if (s.includes(key)) return val;
  }
  return null;
}

function cleanTeamName(name) {
  name = name.trim();
  name = name.replace(/\s+[a-z]{2,4}$/, '');  // "PSV nl" → "PSV"
  name = name.replace(/^[a-z]{2,4}\s+/, '');  // "be Union SG" → "Union SG"
  return name.trim();
}

function parseGoals(s) {
  const m = s.trim().match(/^(?:\(\d+\)\s*)?(\d+)\u2013(\d+)/);
  return m ? [parseInt(m[1]), parseInt(m[2])] : null;
}

function detectSeason(text) {
  // "2025-2026" → "2025/26"
  let m = text.match(/(\d{4})-(\d{4})/);
  if (m) return m[1] + '/' + m[2].slice(2);
  // "2025/26"
  m = text.match(/(\d{4})\/(\d{2})/);
  if (m) return m[1] + '/' + m[2];
  // Fallback: from dates in data
  m = text.match(/(\d{4})-\d{2}-\d{2}/);
  if (m) { const y=parseInt(m[1]); return y+'/'+(y+1).toString().slice(2); }
  return null;
}

function parsePaste() {
  const text = document.getElementById('paste-area').value;
  if (!text.trim()) { alert('Paste some text first.'); return; }

  const SCORE_RE = /^(?:\(\d+\)\s*)?\d+\u2013\d+/;
  const lines = text.split('\n');
  const season = detectSeason(text);
  const preview = [];

  for (const rawLine of lines) {
    const line = rawLine.trim();
    if (!line || !line.includes('\u2013')) continue;
    const parts = line.split('\t');
    if (parts.length < 6) continue;
    const r0 = parts[0].trim();
    if (['Round','Glossary'].includes(r0)) continue;
    if (r0.startsWith('All Rounds')) continue;

    let scoreIdx = null;
    for (let i = 0; i < parts.length; i++) {
      if (SCORE_RE.test(parts[i].trim())) { scoreIdx = i; break; }
    }
    if (scoreIdx === null || scoreIdx < 1 || scoreIdx + 1 >= parts.length) continue;

    const phase = parsePhase(r0);
    if (!phase) continue;

    const teamA = cleanTeamName(parts[scoreIdx - 1]);
    const teamB = cleanTeamName(parts[scoreIdx + 1]);
    if (!teamA || !teamB || teamA.length < 2 || teamB.length < 2) continue;
    if (/^\d/.test(teamA) || /^\d/.test(teamB)) continue;

    const goals = parseGoals(parts[scoreIdx]);
    if (!goals) continue;

    const warnA = allTeamsSorted.length > 0 && !allTeamsSorted.includes(teamA);
    const warnB = allTeamsSorted.length > 0 && !allTeamsSorted.includes(teamB);

    preview.push({ phase, season: season||'?', teamA, goalsA:goals[0], teamB, goalsB:goals[1], warnA, warnB });
  }

  parsedMatches = preview;

  const previewEl = document.getElementById('parse-preview');
  const summaryEl = document.getElementById('parse-summary');
  const tbody = document.getElementById('parse-preview-body');
  document.getElementById('parse-msg').style.display = 'none';

  if (!preview.length) {
    summaryEl.style.cssText = 'background:#f8717120;color:#f87171;border:1px solid #f8717140;';
    summaryEl.textContent = 'No matches found. Make sure text is copied correctly from fbref.';
    tbody.innerHTML = ''; previewEl.style.display = 'block'; return;
  }

  const warns = preview.filter(m => m.warnA || m.warnB).length;
  const pc = {};
  preview.forEach(m => { pc[m.phase] = (pc[m.phase]||0)+1; });
  const phStr = Object.entries(pc).map(([p,n])=>n+'× '+p).join(', ');
  const PL = {group:'GR',r16:'R16',qf:'QF',sf:'SF',final:'FIN'};

  summaryEl.style.cssText = 'background:#4ade8020;color:#4ade80;border:1px solid #4ade8040;';
  summaryEl.innerHTML = `Found <strong>${preview.length}</strong> matches` +
    (season ? ` &nbsp;·&nbsp; Season <strong>${season}</strong>` : '') +
    ` &nbsp;·&nbsp; ${phStr}` +
    (warns ? ` &nbsp;·&nbsp; <span style="color:#f59e0b">⚠ ${warns} new/unknown teams</span>` : '');

  tbody.innerHTML = preview.map(m => `<tr>
    <td class="td-phase">${PL[m.phase]||m.phase}</td>
    <td style="color:#4a5568;font-size:10px">${m.season}</td>
    <td class="td-team ${m.warnA?'td-warn':''}">${m.teamA}${m.warnA?' ⚠':''}</td>
    <td class="td-score">${m.goalsA} – ${m.goalsB}</td>
    <td class="td-team ${m.warnB?'td-warn':''}">${m.teamB}${m.warnB?' ⚠':''}</td>
  </tr>`).join('');

  previewEl.style.display = 'block';
}

async function importParsed() {
  const pass = document.getElementById('adm-pass').value;
  if (!pass) { alert('Enter password first.'); return; }
  if (!parsedMatches.length) { alert('Nothing to import. Parse first.'); return; }

  const btn = document.getElementById('import-btn');
  const msgEl = document.getElementById('parse-msg');
  btn.textContent = 'Importing…'; btn.disabled = true;

  let ok = 0, fail = 0;
  for (const m of parsedMatches) {
    try {
      const r = await fetch('save_match.php', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ password:pass, season:m.season, phase:m.phase,
          teamA:m.teamA, goalsA:m.goalsA, teamB:m.teamB, goalsB:m.goalsB })
      });
      const d = await r.json();
      if (r.ok && d.success) ok++; else fail++;
    } catch(e) { fail++; }
  }

  btn.textContent = '✓ Import All to Server'; btn.disabled = false;
  msgEl.style.cssText = ok > 0
    ? 'background:#4ade8020;color:#4ade80;border:1px solid #4ade8040;display:block;'
    : 'background:#f8717120;color:#f87171;border:1px solid #f8717140;display:block;';
  msgEl.textContent = ok > 0
    ? `✓ Imported ${ok} matches${fail?' ('+fail+' failed)':''}.  Reloading…`
    : 'Import failed — check password and server.';

  if (ok > 0) {
    parsedMatches = [];
    document.getElementById('parse-preview').style.display = 'none';
    document.getElementById('parse-preview-body').innerHTML = '';
    setTimeout(() => loadAndRender(), 1500);
  }
}

function clearPaste() {
  document.getElementById('paste-area').value = '';
  document.getElementById('parse-preview').style.display = 'none';
  document.getElementById('parse-msg').style.display = 'none';
  parsedMatches = [];
}

// ── Boot ──────────────────────────────────────────────────────────
loadAndRender();
</script>
</body>
</html>