<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>UEFA Champions League ELO Ranking</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Bebas+Neue&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #07080d; color: #e2e8f0; font-family: 'Inter', sans-serif; min-height: 100vh; }
    ::-webkit-scrollbar { width: 5px; }
    ::-webkit-scrollbar-track { background: #0d0e14; }
    ::-webkit-scrollbar-thumb { background: #2a2d3e; border-radius: 4px; }


    /* Back link */
    .back-link{display:inline-flex;align-items:center;gap:6px;font-family:'DM Mono',monospace;font-size:10px;color:#4a5568;letter-spacing:2px;text-decoration:none;margin-bottom:16px;transition:color .15s;}
    .back-link:hover{color:#fbbf24;}
    /* ── Hero ── */
    #hero { position: relative; overflow: hidden; padding: 0 24px; border-bottom: 1px solid #1a1c2e; min-height: 260px; }
    #hero-bg { position: absolute; inset: -30px; z-index: 0; background: url('data:image/png;base64,') center center / cover no-repeat; will-change: transform; }
    #hero-overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(7,8,13,0.72) 0%, rgba(7,8,13,0.62) 50%, rgba(7,8,13,0.92) 100%); }
    #hero-watermark { position: absolute; right: -20px; top: 50%; transform: translateY(-50%); font-size: 240px; opacity: .04; line-height: 1; pointer-events: none; font-family: 'Bebas Neue', sans-serif; color: #fff; letter-spacing: -6px; user-select: none; z-index: 2; }
    #hero-inner { position: relative; z-index: 3; max-width: 960px; margin: 0 auto; padding: 36px 0 0; }
    .hero-eyebrow { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 4px; color: #fbbf24; text-transform: uppercase; margin-bottom: 8px; display: flex; align-items: center; gap: 8px; }
    .hero-eyebrow::before { content:""; display:block; width:24px; height:1px; background:#fbbf24; }
    .hero-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(40px,7vw,68px); letter-spacing: 3px; line-height: .95; color: #fff; }
    .hero-title span { color: #fbbf24; }
    .hero-subtitle { margin-top: 12px; font-family: 'DM Mono', monospace; font-size: 11px; color: rgba(255,255,255,0.55); letter-spacing: 2px; }
    #hero-stats { display: flex; margin-top: 32px; border-top: 1px solid rgba(255,255,255,0.08); }
    .hero-stat { flex: 1; padding: 16px 0; border-right: 1px solid rgba(255,255,255,0.06); text-align: center; }
    .hero-stat:last-child { border-right: none; }
    .hero-stat-val { font-family: 'Bebas Neue', sans-serif; font-size: 32px; color: #fbbf24; letter-spacing: 2px; line-height: 1; }
    .hero-stat-label { font-family: 'DM Mono', monospace; font-size: 9px; color: rgba(255,255,255,0.4); letter-spacing: 2px; text-transform: uppercase; margin-top: 3px; }

    /* ── Tabs ── */
    #tabs-bar { background: #0a0b11; border-bottom: 1px solid #1a1c2e; padding: 0 24px; position: sticky; top: 0; z-index: 100; box-shadow: 0 4px 20px rgba(0,0,0,.6); }
    #tabs-inner { max-width: 960px; margin: 0 auto; display: flex; }
    .tab-btn { background: none; border: none; border-bottom: 2px solid transparent; cursor: pointer; font-family: 'DM Mono', monospace; font-size: 11px; padding: 14px 20px; color: #4a5568; transition: all .2s; letter-spacing: 2px; text-transform: uppercase; }
    .tab-btn.active { color: #fbbf24; border-bottom-color: #fbbf24; }
    .tab-btn:hover:not(.active) { color: #94a3b8; }

    /* ── Content ── */
    #content { max-width: 960px; margin: 0 auto; padding: 28px 24px; }
    .panel { display: none; }
    .panel.active { display: block; animation: fadeIn .25s ease; }
    @keyframes fadeIn { from {opacity:0;transform:translateY(6px);} to {opacity:1;transform:translateY(0);} }

    /* ── Country chips ── */
    #country-filters { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 18px; }
    .country-chip { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 1px; padding: 5px 10px; cursor: pointer; border-radius: 3px; transition: all .15s; border: 1px solid #1e2030; background: #0f1017; color: #4a5568; white-space: nowrap; }
    .country-chip:hover { color: #94a3b8; border-color: #2a2d3e; }
    .country-chip.active { background: #fbbf2415; border-color: #fbbf24; color: #fbbf24; }

    /* ── Ranking ── */
    #ranking-wrap { border: 1px solid #1a1c2e; border-radius: 4px; overflow: hidden; }
    .rank-row { display: grid; grid-template-columns: 44px 44px 1fr 70px 55px 110px 70px; gap: 10px; align-items: center; padding: 10px 16px; border-bottom: 1px solid #111320; transition: background .12s; }
    .rank-row:last-child { border-bottom: none; }
    .rank-row:hover { background: #0f1120; }
    .rank-row.top1 { background: linear-gradient(90deg,#fbbf2408 0%,transparent 60%); }
    .rank-row.top3 { background: linear-gradient(90deg,#60a5fa06 0%,transparent 60%); }
    .rank-pos { font-family: 'DM Mono', monospace; font-size: 9px; color: #4a5568; text-align: center; }
    .rank-badge { font-family: 'DM Mono', monospace; font-size: 9px; font-weight: 700; letter-spacing: 1px; padding: 3px 6px; border-radius: 3px; text-align: center; white-space: nowrap; display: inline-flex; align-items: center; justify-content: center; min-width: 32px; }
    .rank-name { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 500; }
    .rank-country-name { font-family: 'DM Mono', monospace; font-size: 10px; color: #2a2d3e; margin-top: 1px; }
    .rank-elo { font-family: 'Bebas Neue', sans-serif; font-size: 22px; letter-spacing: 1px; line-height: 1; }
    .rank-delta { font-family: 'DM Mono', monospace; font-size: 11px; }
    .rank-matches { font-family: 'DM Mono', monospace; font-size: 11px; color: #4a5568; text-align: right; }
    .rank-bar-wrap { height: 3px; background: #1a1c2e; border-radius: 2px; overflow: hidden; }
    .rank-bar { height: 100%; border-radius: 2px; }
    .rank-header { background: #0a0b13 !important; border-bottom: 1px solid #1a1c2e !important; cursor: default !important; }
    .rank-header:hover { background: #0a0b13 !important; }
    .rank-header-cell { font-family: 'DM Mono', monospace; font-size: 9px; color: #4a5568; letter-spacing: 2px; text-transform: uppercase; }
    .medal-1 { background: #fbbf2420; color: #fbbf24; border: 1px solid #fbbf2440; }
    .medal-2 { background: #94a3b820; color: #94a3b8; border: 1px solid #94a3b840; }
    .medal-3 { background: #cd7f3220; color: #cd7f32; border: 1px solid #cd7f3240; }
    .medal-n { background: #1e2030; color: #4a5568; border: 1px solid #2a2d3e; }

    /* ── History ── */
    #hist-controls { display: flex; gap: 10px; margin-bottom: 18px; flex-wrap: wrap; }
    .hist-input { background: #0f1017; border: 1px solid #1e2030; color: #e2e8f0; padding: 9px 14px; font-family: 'DM Mono', monospace; font-size: 12px; outline: none; border-radius: 3px; transition: border-color .15s; }
    .hist-input:focus { border-color: #fbbf24; }
    #hist-list { border: 1px solid #1a1c2e; border-radius: 4px; overflow: hidden; }
    .season-divider { padding: 6px 16px; background: #0a0b13; font-family: 'DM Mono', monospace; font-size: 10px; color: #fbbf24; letter-spacing: 3px; border-bottom: 1px solid #1a1c2e; }
    .hist-row { display: grid; grid-template-columns: 52px 1fr auto 1fr; gap: 10px; align-items: center; padding: 9px 16px; border-bottom: 1px solid #111320; font-size: 12px; transition: background .12s; }
    .hist-row:hover { background: #0f1120; }
    .hist-row:last-child { border-bottom: none; }
    .hist-score { text-align: center; font-family: 'Bebas Neue', sans-serif; font-size: 20px; color: #e2e8f0; white-space: nowrap; letter-spacing: 1px; }
    .hist-team { display: flex; flex-direction: column; gap: 2px; }
    .hist-team-name { display: flex; align-items: center; gap: 6px; font-family: 'Inter', sans-serif; font-weight: 500; }
    .hist-elo-diff { font-family: 'DM Mono', monospace; font-size: 10px; color: #2a2d3e; }
    .badge { font-family: 'DM Mono', monospace; font-size: 9px; padding: 2px 6px; border-radius: 2px; text-transform: uppercase; letter-spacing: 1px; font-weight: 700; white-space: nowrap; display: inline-block; }
    .win  { color: #4ade80; }
    .draw { color: #94a3b8; }
    .loss { color: #f87171; }
    .empty { padding: 48px; text-align: center; color: #2a2d3e; font-family: 'DM Mono', monospace; font-size: 12px; letter-spacing: 2px; }

    /* ── Stats ── */
    .stats-season-card { background: #0f1017; border: 1px solid #1a1c2e; border-radius: 4px; padding: 12px 16px; display: flex; align-items: center; gap: 12px; transition: background .12s; }
    .stats-season-card:hover { background: #111320; }
    .stats-season-label { font-family: 'DM Mono', monospace; font-size: 10px; color: #fbbf24; letter-spacing: 2px; min-width: 70px; }
    .stats-season-elo { font-family: 'Bebas Neue', sans-serif; font-size: 20px; letter-spacing: 1px; min-width: 60px; }
    .stats-season-delta { font-family: 'DM Mono', monospace; font-size: 11px; min-width: 50px; }
    .stats-season-matches { font-family: 'DM Mono', monospace; font-size: 10px; color: #4a5568; }
    .stats-season-bar-wrap { flex: 1; height: 3px; background: #1a1c2e; border-radius: 2px; overflow: hidden; }
    .stats-season-bar { height: 100%; border-radius: 2px; }
    #stats-season-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .stats-peak-banner { background: linear-gradient(90deg,#fbbf2412,transparent); border: 1px solid #fbbf2430; border-radius: 4px; padding: 12px 16px; margin-bottom: 16px; font-family: 'DM Mono', monospace; font-size: 11px; color: #94a3b8; letter-spacing: 1px; display: flex; gap: 20px; flex-wrap: wrap; }
    .stats-peak-val { color: #fbbf24; font-size: 14px; font-family: 'Bebas Neue', sans-serif; letter-spacing: 2px; }

    /* ── Compare ── */
    .compare-table { width: 100%; border-collapse: collapse; font-family: 'DM Mono', monospace; font-size: 12px; }
    .compare-table th { padding: 8px 14px; background: #0a0b13; color: #4a5568; font-size: 9px; letter-spacing: 2px; text-transform: uppercase; border-bottom: 1px solid #1a1c2e; font-weight: 400; }
    .compare-table td { padding: 9px 14px; border-bottom: 1px solid #111320; }
    .compare-table tr:last-child td { border-bottom: none; }
    .compare-table tr:hover td { background: #0f1120; }
    .compare-table .season-col { color: #fbbf24; letter-spacing: 2px; font-size: 10px; }
    .compare-badge { display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 4px; font-family: 'DM Mono', monospace; font-size: 11px; }
    .compare-badges-row { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }


    /* ── Paste parser ── */
    #paste-area { width:100%; min-height:180px; background:#07080d; border:1px solid #1e2030; color:#e2e8f0; padding:12px; font-family:'DM Mono',monospace; font-size:11px; outline:none; border-radius:3px; resize:vertical; transition:border-color .15s; line-height:1.6; }
    #paste-area:focus { border-color:#fbbf24; }
    #paste-area::placeholder { color:#2a2d3e; }
    #parse-preview { margin-top:14px; display:none; }
    .parse-table { width:100%; border-collapse:collapse; font-family:'DM Mono',monospace; font-size:11px; }
    .parse-table th { padding:6px 12px; background:#0a0b13; color:#4a5568; font-size:9px; letter-spacing:2px; text-transform:uppercase; border-bottom:1px solid #1a1c2e; font-weight:400; text-align:left; }
    .parse-table td { padding:7px 12px; border-bottom:1px solid #111320; color:#94a3b8; }
    .parse-table tr:hover td { background:#0f1120; }
    .td-phase { color:#60a5fa; font-size:9px; }
    .td-score { text-align:center; font-family:'Bebas Neue',sans-serif; font-size:16px; color:#e2e8f0; }
    .td-team { color:#e2e8f0; }
    .td-warn { color:#f59e0b; }

    /* ── Admin panel ── */
    #admin-toggle { display: block; text-align: center; margin-top: 40px; margin-bottom: 16px; font-family: 'DM Mono', monospace; font-size: 10px; color: #2a2d3e; letter-spacing: 2px; cursor: pointer; text-decoration: none; padding: 8px; }
    #admin-toggle:hover { color: #4a5568; }
    #admin-panel { display: none; margin-top: 16px; background: #0f1017; border: 1px solid #1a1c2e; border-radius: 6px; padding: 24px; }
    #admin-panel h3 { font-family: 'DM Mono', monospace; font-size: 10px; color: #fbbf24; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px solid #1a1c2e; }
    .admin-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px; }
    .admin-field-label { font-family: 'DM Mono', monospace; font-size: 9px; color: #4a5568; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 4px; }
    .admin-input { background: #07080d; border: 1px solid #1e2030; color: #e2e8f0; padding: 8px 12px; font-family: 'DM Mono', monospace; font-size: 12px; outline: none; border-radius: 3px; width: 100%; transition: border-color .15s; }
    .admin-input:focus { border-color: #fbbf24; }
    .admin-btn { background: #fbbf24; color: #000; border: none; padding: 10px 24px; font-family: 'DM Mono', monospace; font-size: 12px; font-weight: 700; cursor: pointer; border-radius: 3px; letter-spacing: 1px; text-transform: uppercase; transition: opacity .2s; margin-top: 10px; }
    .admin-btn:hover { opacity: .85; }
    .admin-btn.danger { background: #ef4444; color: #fff; }
    #admin-msg { margin-top: 12px; font-family: 'DM Mono', monospace; font-size: 11px; padding: 8px 12px; border-radius: 3px; display: none; }
    #admin-msg.ok { background: #4ade8020; color: #4ade80; border: 1px solid #4ade8040; }
    #admin-msg.err { background: #f8717120; color: #f87171; border: 1px solid #f8717140; }

    /* ── About ── */
    .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .about-card { background: #0f1017; border: 1px solid #1a1c2e; border-radius: 6px; padding: 20px; }
    .about-card h3 { font-family: 'DM Mono', monospace; font-size: 10px; color: #fbbf24; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid #1a1c2e; }
    .about-card p, .about-card li { font-family: 'DM Mono', monospace; font-size: 12px; color: #64748b; line-height: 2; }
    .about-card li { padding-left: 12px; }
    .about-card .formula { font-size: 15px; color: #e2e8f0; margin-bottom: 8px; font-family: 'Bebas Neue', sans-serif; letter-spacing: 2px; }

    /* ── Mobile ── */
    @media (max-width: 680px) {
      #hero { padding: 0 16px; }
      #hero-inner { padding: 24px 0 0; }
      .hero-title { font-size: 36px; }
      .hero-stat-val { font-size: 24px; }
      .hero-stat { padding: 12px 0; }
      #tabs-bar { padding: 0 8px; }
      .tab-btn { padding: 12px 10px; font-size: 10px; letter-spacing: 1px; }
      #content { padding: 16px; }
      .country-chip { font-size: 9px; padding: 4px 7px; }
      .rank-row { grid-template-columns: 36px 36px 1fr 54px 44px; gap: 6px; padding: 9px 12px; }
      .rank-row > .rank-bar-wrap, .rank-row > .rank-matches { display: none; }
      .rank-header .rank-header-cell:nth-child(6), .rank-header .rank-header-cell:nth-child(7) { display: none; }
      .rank-country-name { display: none; }
      .rank-elo { font-size: 18px; }
      .rank-name { font-size: 12px; }
      #hist-controls { flex-direction: column; }
      .hist-input { width: 100%; }
      .hist-row { grid-template-columns: 40px 1fr auto 1fr; gap: 6px; padding: 8px 12px; }
      .hist-score { font-size: 16px; }
      #stats-season-grid { grid-template-columns: 1fr; }
      .about-grid { grid-template-columns: 1fr; }
      .admin-grid { grid-template-columns: 1fr; }
      .compare-badges-row { flex-direction: column; }
    }
    @media (max-width: 400px) {
      .hero-title { font-size: 30px; }
      .rank-row { grid-template-columns: 32px 32px 1fr 48px; gap: 4px; }
      .rank-row > .rank-delta { display: none; }
    }
  </style>
</head>
<body>

<div id="hero">
  <div id="hero-bg"></div>
  <div id="hero-overlay"></div>
  <div id="hero-watermark">UCL</div>
  <div id="hero-inner">
    <a class="back-link" href="../">← All Rankings</a>
    <div class="hero-eyebrow">UEFA Champions League</div>
    <div class="hero-title">ELO <span>Ranking</span></div>
    <div class="hero-subtitle" id="hero-sub">Loading…</div>
  </div>
  <div style="max-width:960px;margin:0 auto;position:relative;z-index:3;">
    <div id="hero-stats">
      <div class="hero-stat"><div class="hero-stat-val" id="stat-seasons">—</div><div class="hero-stat-label">Seasons</div></div>
      <div class="hero-stat"><div class="hero-stat-val" id="stat-matches">—</div><div class="hero-stat-label">Matches</div></div>
      <div class="hero-stat"><div class="hero-stat-val" id="stat-clubs">—</div><div class="hero-stat-label">Clubs</div></div>
    </div>
  </div>
</div>

<div id="tabs-bar">
  <div id="tabs-inner">
    <button class="tab-btn active" onclick="switchTab('ranking',this)">Ranking</button>
    <button class="tab-btn" onclick="switchTab('history',this)">History</button>
    <button class="tab-btn" onclick="switchTab('stats',this)">Stats</button>
    <button class="tab-btn" onclick="switchTab('compare',this)">Compare</button>
    <button class="tab-btn" onclick="switchTab('about',this)">About</button>
  </div>
</div>

<div id="content">

  <!-- RANKING -->
  <div id="panel-ranking" class="panel active">
    <div id="country-filters"></div>
    <div id="ranking-wrap">
      <div class="rank-row rank-header">
        <span class="rank-header-cell" style="text-align:center;min-width:44px">Pos</span>
        <span class="rank-header-cell">Country</span>
        <span class="rank-header-cell">Club</span>
        <span class="rank-header-cell">ELO</span>
        <span class="rank-header-cell">Delta</span>
        <span class="rank-header-cell"></span>
        <span class="rank-header-cell" style="text-align:right">Matches</span>
      </div>
      <div id="ranking-table"></div>
    </div>
  </div>

  <!-- HISTORY -->
  <div id="panel-history" class="panel">
    <div id="hist-controls">
      <select id="hist-team-filter" class="hist-input" style="min-width:240px;max-width:320px;font-size:11px;" onchange="renderHistory()">
        <option value="">All clubs</option>
      </select>
      <select id="hist-filter" class="hist-input" style="min-width:160px;" onchange="renderHistory()">
        <option value="">All seasons</option>
      </select>
    </div>
    <div id="hist-list"></div>
  </div>

  <!-- STATS -->
  <div id="panel-stats" class="panel">
    <div style="display:flex;gap:10px;margin-bottom:20px;flex-wrap:wrap;align-items:center;">
      <select id="stats-club-select" class="hist-input" style="min-width:260px;max-width:340px;font-size:11px;" onchange="renderStats()">
        <option value="">Select a club…</option>
      </select>
      <div id="stats-club-info" style="font-family:'DM Mono',monospace;font-size:11px;color:#4a5568;letter-spacing:1px;"></div>
    </div>
    <div id="stats-chart-wrap" style="background:#0f1017;border:1px solid #1a1c2e;border-radius:6px;padding:20px 20px 12px;margin-bottom:20px;display:none;">
      <canvas id="stats-chart" style="max-height:340px;"></canvas>
    </div>
    <div id="stats-season-grid" style="display:none;"></div>
    <div id="stats-empty" style="padding:48px;text-align:center;color:#2a2d3e;font-family:'DM Mono',monospace;font-size:12px;letter-spacing:2px;">SELECT A CLUB TO VIEW ELO PROGRESSION</div>
  </div>

  <!-- COMPARE -->
  <div id="panel-compare" class="panel">
    <div style="display:flex;gap:10px;margin-bottom:20px;flex-wrap:wrap;align-items:center;">
      <select id="compare-club-a" class="hist-input" style="min-width:240px;max-width:320px;font-size:11px;" onchange="renderCompare()">
        <option value="">Club A…</option>
      </select>
      <span style="font-family:'DM Mono',monospace;font-size:14px;color:#4a5568;">vs</span>
      <select id="compare-club-b" class="hist-input" style="min-width:240px;max-width:320px;font-size:11px;" onchange="renderCompare()">
        <option value="">Club B…</option>
      </select>
    </div>
    <div id="compare-badges"></div>
    <div id="compare-chart-wrap" style="background:#0f1017;border:1px solid #1a1c2e;border-radius:6px;padding:20px 20px 12px;margin-bottom:20px;display:none;">
      <canvas id="compare-chart" style="max-height:360px;"></canvas>
    </div>
    <div id="compare-season-table"></div>
    <div id="compare-empty" style="padding:48px;text-align:center;color:#2a2d3e;font-family:'DM Mono',monospace;font-size:12px;letter-spacing:2px;">SELECT TWO CLUBS TO COMPARE</div>
  </div>

  <!-- ABOUT -->
  <div id="panel-about" class="panel">
    <div class="about-grid">
      <div class="about-card">
        <h3>ELO Formula</h3>
        <div class="formula">R = R + K &times; (S &minus; E)</div>
        <p>E = 1 / (1 + 10^((R_opp &minus; R_self) / 400))</p>
        <p>S: 1 = win &nbsp;&middot;&nbsp; 0.5 = draw &nbsp;&middot;&nbsp; 0 = loss</p>
        <p style="margin-top:8px;">Base ELO = 1600 (all clubs start equal)</p>
      </div>
      <div class="about-card">
        <h3>K-Factors</h3>
        <ul>
          <li>Group / League phase &rarr; K = 8</li>
          <li>Round of 16 / Quarter-finals &rarr; K = 16</li>
          <li>Semi-finals &rarr; K = 24</li>
          <li>Final &rarr; K = 32</li>
          <li>Qualifying rounds &rarr; K = 0 (excluded)</li>
        </ul>
      </div>
      <div class="about-card">
        <h3>Notes</h3>
        <ul>
          <li>Penalty shootouts counted as draws</li>
          <li>90-minute score used throughout</li>
          <li>Only group stage onwards counted</li>
        </ul>
      </div>
      <div class="about-card">
        <h3>Coverage</h3>
        <ul>
          <li>1992/93 &mdash; 2025/26 (ongoing)</li>
          <li>160 clubs &middot; 34 seasons</li>
          <li>Country codes: UEFA standard (ENG/SCO separate)</li>
        </ul>
      </div>
    </div>
  </div>

</div>

<!-- ADMIN (hidden, accessible via footer link) -->
<div style="padding:16px 24px 0;">
  <a id="admin-toggle" onclick="toggleAdmin()" href="#">· · ·</a>
  <div id="admin-panel">
    <h3>Add Match</h3>
    <div class="admin-grid">
      <div>
        <div class="admin-field-label">Password</div>
        <input id="adm-pass" class="admin-input" type="password" placeholder="••••••••">
      </div>
      <div>
        <div class="admin-field-label">Season</div>
        <input id="adm-season" class="admin-input" type="text" placeholder="2025/26">
      </div>
      <div>
        <div class="admin-field-label">Home Club</div>
        <input id="adm-teamA" class="admin-input" type="text" placeholder="Real Madrid" list="adm-teams-list">
      </div>
      <div>
        <div class="admin-field-label">Away Club</div>
        <input id="adm-teamB" class="admin-input" type="text" placeholder="Bayern Munich" list="adm-teams-list">
      </div>
      <div>
        <div class="admin-field-label">Home Goals</div>
        <input id="adm-goalsA" class="admin-input" type="number" min="0" placeholder="0">
      </div>
      <div>
        <div class="admin-field-label">Away Goals</div>
        <input id="adm-goalsB" class="admin-input" type="number" min="0" placeholder="0">
      </div>
    </div>
    <div>
      <div class="admin-field-label">Phase</div>
      <select id="adm-phase" class="admin-input" style="width:auto;margin-top:4px;">
        <option value="group">Group / League phase (K=8)</option>
        <option value="r16">Round of 16 (K=16)</option>
        <option value="qf">Quarter-final (K=16)</option>
        <option value="sf">Semi-final (K=24)</option>
        <option value="final">Final (K=32)</option>
      </select>
    </div>
    <datalist id="adm-teams-list"></datalist>
    <button class="admin-btn" onclick="adminAddMatch()">+ Add Match</button>
    <div id="admin-msg"></div>

    <div style="margin-top:24px;padding-top:20px;border-top:1px solid #1a1c2e;">
      <div class="admin-field-label" style="margin-bottom:12px;">Recent Matches (last 20)</div>
      <div id="admin-recent" style="font-family:'DM Mono',monospace;font-size:11px;color:#4a5568;letter-spacing:1px;">
        Open panel to load recent matches.
      </div>
      <button class="admin-btn" style="margin-top:12px;background:#1e2030;color:#94a3b8;font-size:11px;" onclick="adminLoadRecent()">↻ Refresh List</button>
    </div>
  </div>
</div>

