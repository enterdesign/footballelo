<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FIFA World Cup ELO Ranking</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Bebas+Neue&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    body{background:#07080d;color:#e2e8f0;font-family:'Inter',sans-serif;min-height:100vh;}
    ::-webkit-scrollbar{width:5px;}
    ::-webkit-scrollbar-track{background:#0d0e14;}
    ::-webkit-scrollbar-thumb{background:#2a2d3e;border-radius:4px;}

    #hero{position:relative;overflow:hidden;padding:0 24px;border-bottom:1px solid #1a1c2e;min-height:220px;background:linear-gradient(135deg,#07080d 0%,#0d1020 50%,#07080d 100%);}
    #hero-watermark{position:absolute;right:-10px;top:50%;transform:translateY(-50%);font-size:200px;opacity:.03;line-height:1;pointer-events:none;font-family:'Bebas Neue',sans-serif;color:#fff;letter-spacing:-6px;user-select:none;z-index:1;}
    #hero-inner{position:relative;z-index:2;max-width:960px;margin:0 auto;padding:32px 0 0;}
    .back-link{display:inline-flex;align-items:center;gap:6px;font-family:'DM Mono',monospace;font-size:10px;color:#4a5568;letter-spacing:2px;text-decoration:none;margin-bottom:16px;transition:color .15s;}
    .back-link:hover{color:#fbbf24;}
    .hero-eyebrow{font-family:'DM Mono',monospace;font-size:10px;letter-spacing:4px;color:#f59e0b;text-transform:uppercase;margin-bottom:8px;display:flex;align-items:center;gap:8px;}
    .hero-eyebrow::before{content:"";display:block;width:24px;height:1px;background:#f59e0b;}
    .hero-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(38px,6vw,64px);letter-spacing:3px;line-height:.95;color:#fff;}
    .hero-title span{color:#f59e0b;}
    .hero-subtitle{margin-top:12px;font-family:'DM Mono',monospace;font-size:11px;color:rgba(255,255,255,0.5);letter-spacing:2px;}
    #hero-stats{display:flex;margin-top:28px;border-top:1px solid rgba(255,255,255,0.06);}
    .hero-stat{flex:1;padding:14px 0;border-right:1px solid rgba(255,255,255,0.05);text-align:center;}
    .hero-stat:last-child{border-right:none;}
    .hero-stat-val{font-family:'Bebas Neue',sans-serif;font-size:28px;color:#f59e0b;letter-spacing:2px;line-height:1;}
    .hero-stat-label{font-family:'DM Mono',monospace;font-size:9px;color:rgba(255,255,255,0.35);letter-spacing:2px;text-transform:uppercase;margin-top:3px;}

    #tabs-bar{background:#0a0b11;border-bottom:1px solid #1a1c2e;padding:0 24px;position:sticky;top:0;z-index:100;box-shadow:0 4px 20px rgba(0,0,0,.6);}
    #tabs-inner{max-width:960px;margin:0 auto;display:flex;}
    .tab-btn{background:none;border:none;border-bottom:2px solid transparent;cursor:pointer;font-family:'DM Mono',monospace;font-size:11px;padding:14px 20px;color:#4a5568;transition:all .2s;letter-spacing:2px;text-transform:uppercase;}
    .tab-btn.active{color:#f59e0b;border-bottom-color:#f59e0b;}
    .tab-btn:hover:not(.active){color:#94a3b8;}

    #content{max-width:960px;margin:0 auto;padding:28px 24px;}
    .panel{display:none;}
    .panel.active{display:block;animation:fadeIn .25s ease;}
    @keyframes fadeIn{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}

    /* Region chips */
    #region-filters{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:18px;}
    .region-chip{font-family:'DM Mono',monospace;font-size:10px;letter-spacing:1px;padding:5px 10px;cursor:pointer;border-radius:3px;transition:all .15s;border:1px solid #1e2030;background:#0f1017;color:#4a5568;white-space:nowrap;}
    .region-chip:hover{color:#94a3b8;border-color:#2a2d3e;}
    .region-chip.active{background:#f59e0b15;border-color:#f59e0b;color:#f59e0b;}

    /* Ranking */
    #ranking-wrap{border:1px solid #1a1c2e;border-radius:4px;overflow:hidden;}
    .rank-row{display:grid;grid-template-columns:44px 70px 1fr 70px 55px 110px 70px;gap:10px;align-items:center;padding:10px 16px;border-bottom:1px solid #111320;transition:background .12s;}
    .rank-row:last-child{border-bottom:none;}
    .rank-row:hover{background:#0f1120;}
    .rank-row.top1{background:linear-gradient(90deg,#f59e0b08 0%,transparent 60%);}
    .rank-row.top3{background:linear-gradient(90deg,#60a5fa06 0%,transparent 60%);}
    .rank-header{background:#0a0b13!important;border-bottom:1px solid #1a1c2e!important;cursor:default!important;}
    .rank-header:hover{background:#0a0b13!important;}
    .rank-header-cell{font-family:'DM Mono',monospace;font-size:9px;color:#4a5568;letter-spacing:2px;text-transform:uppercase;}
    .rank-badge{font-family:'DM Mono',monospace;font-size:9px;font-weight:700;letter-spacing:1px;padding:3px 6px;border-radius:3px;text-align:center;white-space:nowrap;display:inline-flex;align-items:center;justify-content:center;min-width:32px;}
    .rank-name{font-family:'Inter',sans-serif;font-size:13px;font-weight:500;}
    .rank-region-name{font-family:'DM Mono',monospace;font-size:10px;color:#2a2d3e;margin-top:1px;}
    .rank-elo{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:1px;line-height:1;}
    .rank-delta{font-family:'DM Mono',monospace;font-size:11px;}
    .rank-matches{font-family:'DM Mono',monospace;font-size:11px;color:#4a5568;text-align:right;}
    .rank-bar-wrap{height:3px;background:#1a1c2e;border-radius:2px;overflow:hidden;}
    .rank-bar{height:100%;border-radius:2px;}
    .medal-1{background:#f59e0b20;color:#f59e0b;border:1px solid #f59e0b40;}
    .medal-2{background:#94a3b820;color:#94a3b8;border:1px solid #94a3b840;}
    .medal-3{background:#cd7f3220;color:#cd7f32;border:1px solid #cd7f3240;}
    .medal-n{background:#1e2030;color:#4a5568;border:1px solid #2a2d3e;}

    /* History */
    #hist-controls{display:flex;gap:10px;margin-bottom:18px;flex-wrap:wrap;}
    .hist-input{background:#0f1017;border:1px solid #1e2030;color:#e2e8f0;padding:9px 14px;font-family:'DM Mono',monospace;font-size:12px;outline:none;border-radius:3px;transition:border-color .15s;}
    .hist-input:focus{border-color:#f59e0b;}
    #hist-list{border:1px solid #1a1c2e;border-radius:4px;overflow:hidden;}
    .season-divider{padding:6px 16px;background:#0a0b13;font-family:'DM Mono',monospace;font-size:10px;color:#f59e0b;letter-spacing:3px;border-bottom:1px solid #1a1c2e;}
    .hist-row{display:grid;grid-template-columns:52px 1fr auto 1fr;gap:10px;align-items:center;padding:9px 16px;border-bottom:1px solid #111320;font-size:12px;transition:background .12s;}
    .hist-row:hover{background:#0f1120;}
    .hist-row:last-child{border-bottom:none;}
    .hist-score{text-align:center;font-family:'Bebas Neue',sans-serif;font-size:20px;color:#e2e8f0;white-space:nowrap;letter-spacing:1px;}
    .hist-team{display:flex;flex-direction:column;gap:2px;}
    .hist-team-name{display:flex;align-items:center;gap:6px;font-family:'Inter',sans-serif;font-weight:500;}
    .hist-elo-diff{font-family:'DM Mono',monospace;font-size:10px;color:#2a2d3e;}
    .badge{font-family:'DM Mono',monospace;font-size:9px;padding:2px 6px;border-radius:2px;text-transform:uppercase;letter-spacing:1px;font-weight:700;white-space:nowrap;display:inline-block;}
    .win{color:#4ade80;}.draw{color:#94a3b8;}.loss{color:#f87171;}
    .empty{padding:48px;text-align:center;color:#2a2d3e;font-family:'DM Mono',monospace;font-size:12px;letter-spacing:2px;}

    /* Stats */
    .stats-season-card{background:#0f1017;border:1px solid #1a1c2e;border-radius:4px;padding:12px 16px;display:flex;align-items:center;gap:12px;transition:background .12s;}
    .stats-season-card:hover{background:#111320;}
    .stats-season-label{font-family:'DM Mono',monospace;font-size:10px;color:#f59e0b;letter-spacing:2px;min-width:48px;}
    .stats-season-elo{font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:1px;min-width:56px;}
    .stats-season-delta{font-family:'DM Mono',monospace;font-size:11px;min-width:48px;}
    .stats-season-matches{font-family:'DM Mono',monospace;font-size:10px;color:#4a5568;}
    .stats-season-bar-wrap{flex:1;height:3px;background:#1a1c2e;border-radius:2px;overflow:hidden;}
    .stats-season-bar{height:100%;border-radius:2px;}
    #stats-season-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
    .stats-peak-banner{background:linear-gradient(90deg,#f59e0b12,transparent);border:1px solid #f59e0b30;border-radius:4px;padding:12px 16px;margin-bottom:16px;font-family:'DM Mono',monospace;font-size:11px;color:#94a3b8;letter-spacing:1px;display:flex;gap:20px;flex-wrap:wrap;}
    .stats-peak-val{color:#f59e0b;font-size:14px;font-family:'Bebas Neue',sans-serif;letter-spacing:2px;}

    /* Compare */
    .compare-table{width:100%;border-collapse:collapse;font-family:'DM Mono',monospace;font-size:12px;}
    .compare-table th{padding:8px 14px;background:#0a0b13;color:#4a5568;font-size:9px;letter-spacing:2px;text-transform:uppercase;border-bottom:1px solid #1a1c2e;font-weight:400;}
    .compare-table td{padding:9px 14px;border-bottom:1px solid #111320;}
    .compare-table tr:last-child td{border-bottom:none;}
    .compare-table tr:hover td{background:#0f1120;}
    .compare-table .season-col{color:#f59e0b;letter-spacing:2px;font-size:10px;}
    .compare-badge{display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border-radius:4px;font-family:'DM Mono',monospace;font-size:11px;}
    .compare-badges-row{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:16px;}

    /* About */
    .about-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
    .about-card{background:#0f1017;border:1px solid #1a1c2e;border-radius:6px;padding:20px;}
    .about-card h3{font-family:'DM Mono',monospace;font-size:10px;color:#f59e0b;letter-spacing:3px;text-transform:uppercase;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid #1a1c2e;}
    .about-card p,.about-card li{font-family:'DM Mono',monospace;font-size:12px;color:#64748b;line-height:2;}
    .about-card li{padding-left:12px;}
    .about-card .formula{font-size:15px;color:#e2e8f0;margin-bottom:8px;font-family:'Bebas Neue',sans-serif;letter-spacing:2px;}

    /* Admin */
    #admin-toggle{display:block;text-align:center;margin-top:40px;margin-bottom:16px;font-family:'DM Mono',monospace;font-size:10px;color:#2a2d3e;letter-spacing:2px;cursor:pointer;text-decoration:none;padding:8px;}
    #admin-toggle:hover{color:#4a5568;}
    #admin-panel{display:none;margin-top:16px;background:#0f1017;border:1px solid #1a1c2e;border-radius:6px;padding:24px;}
    #admin-panel h3{font-family:'DM Mono',monospace;font-size:10px;color:#f59e0b;letter-spacing:3px;text-transform:uppercase;margin-bottom:20px;padding-bottom:10px;border-bottom:1px solid #1a1c2e;}
    .admin-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px;}
    .admin-field-label{font-family:'DM Mono',monospace;font-size:9px;color:#4a5568;letter-spacing:2px;text-transform:uppercase;margin-bottom:4px;}
    .admin-input{background:#07080d;border:1px solid #1e2030;color:#e2e8f0;padding:8px 12px;font-family:'DM Mono',monospace;font-size:12px;outline:none;border-radius:3px;width:100%;transition:border-color .15s;}
    .admin-input:focus{border-color:#f59e0b;}
    .admin-btn{background:#f59e0b;color:#000;border:none;padding:10px 24px;font-family:'DM Mono',monospace;font-size:12px;font-weight:700;cursor:pointer;border-radius:3px;letter-spacing:1px;text-transform:uppercase;transition:opacity .2s;margin-top:10px;}
    .admin-btn:hover{opacity:.85;}
    #admin-msg{margin-top:12px;font-family:'DM Mono',monospace;font-size:11px;padding:8px 12px;border-radius:3px;display:none;}
    #admin-msg.ok{background:#4ade8020;color:#4ade80;border:1px solid #4ade8040;}
    #admin-msg.err{background:#f8717120;color:#f87171;border:1px solid #f8717140;}

    @media(max-width:680px){
      #hero{padding:0 16px;}
      .hero-title{font-size:32px;}
      .hero-stat-val{font-size:22px;}
      #tabs-bar{padding:0 8px;}
      .tab-btn{padding:12px 10px;font-size:10px;letter-spacing:1px;}
      #content{padding:16px;}
      .rank-row{grid-template-columns:36px 54px 1fr 50px 40px;gap:6px;padding:9px 12px;}
      .rank-row>.rank-bar-wrap,.rank-row>.rank-matches{display:none;}
      .rank-region-name{display:none;}
      .rank-elo{font-size:18px;}
      .rank-name{font-size:12px;}
      #hist-controls{flex-direction:column;}
      .hist-input{width:100%;}
      #stats-season-grid{grid-template-columns:1fr;}
      .about-grid{grid-template-columns:1fr;}
      .admin-grid{grid-template-columns:1fr;}
    }
  </style>
</head>
<body>

<div id="hero">
  <div id="hero-watermark">WC</div>
  <div id="hero-inner">
    <a class="back-link" href="../">← All Rankings</a>
    <div class="hero-eyebrow">FIFA World Cup</div>
    <div class="hero-title">ELO <span>Ranking</span></div>
    <div class="hero-subtitle" id="hero-sub">Loading…</div>
  </div>
  <div style="max-width:960px;margin:0 auto;position:relative;z-index:2;">
    <div id="hero-stats">
      <div class="hero-stat"><div class="hero-stat-val" id="stat-editions">—</div><div class="hero-stat-label">Editions</div></div>
      <div class="hero-stat"><div class="hero-stat-val" id="stat-matches">—</div><div class="hero-stat-label">Matches</div></div>
      <div class="hero-stat"><div class="hero-stat-val" id="stat-teams">—</div><div class="hero-stat-label">Teams</div></div>
    </div>
  </div>
</div>

<div id="tabs-bar">
  <div id="tabs-inner">
    <button class="tab-btn active" onclick="switchTab('ranking',this)">Ranking</button>
    <button class="tab-btn" onclick="switchTab('history',this)">History</button>
    <button class="tab-btn" onclick="switchTab('stats',this)">Stats</button>
    <button class="tab-btn" onclick="switchTab('compare',this)">Compare</button>
    <button class="tab-btn" onclick="switchTab('about',this)">About</button>
  </div>
</div>

<div id="content">
  <div id="panel-ranking" class="panel active">
    <div id="region-filters"></div>
    <div id="ranking-wrap">
      <div class="rank-row rank-header">
        <span class="rank-header-cell" style="text-align:center">Pos</span>
        <span class="rank-header-cell">Region</span>
        <span class="rank-header-cell">Team</span>
        <span class="rank-header-cell">ELO</span>
        <span class="rank-header-cell">Delta</span>
        <span class="rank-header-cell"></span>
        <span class="rank-header-cell" style="text-align:right">Matches</span>
      </div>
      <div id="ranking-table"></div>
    </div>
  </div>

  <div id="panel-history" class="panel">
    <div id="hist-controls">
      <select id="hist-team-filter" class="hist-input" style="min-width:200px;font-size:11px;" onchange="renderHistory()">
        <option value="">All teams</option>
      </select>
      <select id="hist-year-filter" class="hist-input" style="min-width:140px;" onchange="renderHistory()">
        <option value="">All years</option>
      </select>
    </div>
    <div id="hist-list"></div>
  </div>

  <div id="panel-stats" class="panel">
    <div style="display:flex;gap:10px;margin-bottom:20px;flex-wrap:wrap;align-items:center;">
      <select id="stats-team-select" class="hist-input" style="min-width:220px;font-size:11px;" onchange="renderStats()">
        <option value="">Select a team…</option>
      </select>
      <div id="stats-team-info" style="font-family:'DM Mono',monospace;font-size:11px;color:#4a5568;letter-spacing:1px;"></div>
    </div>
    <div id="stats-chart-wrap" style="background:#0f1017;border:1px solid #1a1c2e;border-radius:6px;padding:20px 20px 12px;margin-bottom:20px;display:none;">
      <canvas id="stats-chart" style="max-height:340px;"></canvas>
    </div>
    <div id="stats-season-grid" style="display:none;"></div>
    <div id="stats-empty" style="padding:48px;text-align:center;color:#2a2d3e;font-family:'DM Mono',monospace;font-size:12px;letter-spacing:2px;">SELECT A TEAM TO VIEW ELO PROGRESSION</div>
  </div>

  <div id="panel-compare" class="panel">
    <div style="display:flex;gap:10px;margin-bottom:20px;flex-wrap:wrap;align-items:center;">
      <select id="compare-team-a" class="hist-input" style="min-width:200px;font-size:11px;" onchange="renderCompare()"><option value="">Team A…</option></select>
      <span style="font-family:'DM Mono',monospace;font-size:14px;color:#4a5568;">vs</span>
      <select id="compare-team-b" class="hist-input" style="min-width:200px;font-size:11px;" onchange="renderCompare()"><option value="">Team B…</option></select>
    </div>
    <div id="compare-badges"></div>
    <div id="compare-chart-wrap" style="background:#0f1017;border:1px solid #1a1c2e;border-radius:6px;padding:20px 20px 12px;margin-bottom:20px;display:none;">
      <canvas id="compare-chart" style="max-height:360px;"></canvas>
    </div>
    <div id="compare-season-table"></div>
    <div id="compare-empty" style="padding:48px;text-align:center;color:#2a2d3e;font-family:'DM Mono',monospace;font-size:12px;letter-spacing:2px;">SELECT TWO TEAMS TO COMPARE</div>
  </div>

  <div id="panel-about" class="panel">
    <div class="about-grid">
      <div class="about-card">
        <h3>ELO Formula</h3>
        <div class="formula">R = R + K &times; (S &minus; E)</div>
        <p>E = 1 / (1 + 10^((R_opp &minus; R_self) / 400))</p>
        <p>S: 1 = win &nbsp;&middot;&nbsp; 0.5 = draw &nbsp;&middot;&nbsp; 0 = loss</p>
        <p style="margin-top:8px;">Base ELO = 1600 &nbsp; (all teams start equal)</p>
      </div>
      <div class="about-card">
        <h3>K-Factors</h3>
        <ul>
          <li>Group stage &rarr; K = 8</li>
          <li>Round of 16 &rarr; K = 16</li>
          <li>Quarter-finals &rarr; K = 24</li>
          <li>Semi-finals &rarr; K = 32</li>
          <li>3rd place match &rarr; K = 16</li>
          <li>Final &rarr; K = 40</li>
        </ul>
      </div>
      <div class="about-card">
        <h3>Notes</h3>
        <ul>
          <li>Penalty shootouts counted as draws (90+ET score used)</li>
          <li>Successor states inherit predecessor ELO</li>
          <li>All tournaments from 1930 included</li>
        </ul>
      </div>
      <div class="about-card">
        <h3>Coverage</h3>
        <ul>
          <li>1930 &mdash; 2022 (22 editions)</li>
          <li>85 national teams</li>
          <li>Regions: UEFA · CONMEBOL · CONCACAF · CAF · AFC · OFC</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<div style="padding:16px 24px 0;">
  <a id="admin-toggle" onclick="toggleAdmin()" href="#">· · ·</a>
  <div id="admin-panel">
    <h3>Add Match</h3>
    <div class="admin-grid">
      <div><div class="admin-field-label">Password</div><input id="adm-pass" class="admin-input" type="password" placeholder="••••••••"></div>
      <div><div class="admin-field-label">Year</div><input id="adm-year" class="admin-input" type="number" placeholder="2026"></div>
      <div><div class="admin-field-label">Home Team</div><input id="adm-teamA" class="admin-input" type="text" placeholder="Brazil" list="adm-teams-list"></div>
      <div><div class="admin-field-label">Away Team</div><input id="adm-teamB" class="admin-input" type="text" placeholder="Argentina" list="adm-teams-list"></div>
      <div><div class="admin-field-label">Home Goals</div><input id="adm-goalsA" class="admin-input" type="number" min="0" placeholder="0"></div>
      <div><div class="admin-field-label">Away Goals</div><input id="adm-goalsB" class="admin-input" type="number" min="0" placeholder="0"></div>
    </div>
    <div>
      <div class="admin-field-label">Phase</div>
      <select id="adm-phase" class="admin-input" style="width:auto;margin-top:4px;">
        <option value="group">Group stage (K=8)</option>
        <option value="r16">Round of 16 (K=16)</option>
        <option value="qf">Quarter-final (K=24)</option>
        <option value="sf">Semi-final (K=32)</option>
        <option value="3rd">3rd place match (K=16)</option>
        <option value="final">Final (K=40)</option>
      </select>
    </div>
    <datalist id="adm-teams-list"></datalist>
    <button class="admin-btn" onclick="adminAddMatch()">+ Add Match</button>
    <div id="admin-msg"></div>
    <div style="margin-top:24px;padding-top:20px;border-top:1px solid #1a1c2e;">
      <div class="admin-field-label" style="margin-bottom:12px;">Recent Matches (last 20)</div>
      <div id="admin-recent" style="font-family:'DM Mono',monospace;font-size:11px;color:#4a5568;">Open panel to load.</div>
      <button class="admin-btn" style="margin-top:12px;background:#1e2030;color:#94a3b8;font-size:11px;" onclick="adminLoadRecent()">&#8635; Refresh List</button>
    </div>
  </div>
</div>

<script>
const INITIAL_ELO = 1600;
const PHASES = {
  group:{label:"GR",  k:8,  color:"#4ade80"},
  r16:  {label:"R16", k:16, color:"#60a5fa"},
  qf:   {label:"QF",  k:24, color:"#a78bfa"},
  sf:   {label:"SF",  k:32, color:"#f97316"},
