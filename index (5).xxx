}, {"year": 2022, "phase": "group", "teamA": "Brazil", "goalsA": 1, "teamB": "Switzerland", "goalsB": 0}, {"year": 2022, "phase": "group", "teamA": "Portugal", "goalsA": 2, "teamB": "Uruguay", "goalsB": 0}, {"year": 2022, "phase": "group", "teamA": "Netherlands", "goalsA": 2, "teamB": "Qatar", "goalsB": 0}, {"year": 2022, "phase": "group", "teamA": "Ecuador", "goalsA": 1, "teamB": "Senegal", "goalsB": 2}, {"year": 2022, "phase": "group", "teamA": "Wales", "goalsA": 0, "teamB": "England", "goalsB": 3}, {"year": 2022, "phase": "group", "teamA": "Iran", "goalsA": 0, "teamB": "United States", "goalsB": 1}, {"year": 2022, "phase": "group", "teamA": "Australia", "goalsA": 1, "teamB": "Denmark", "goalsB": 0}, {"year": 2022, "phase": "group", "teamA": "Tunisia", "goalsA": 1, "teamB": "France", "goalsB": 0}, {"year": 2022, "phase": "group", "teamA": "Saudi Arabia", "goalsA": 1, "teamB": "Mexico", "goalsB": 2}, {"year": 2022, "phase": "group", "teamA": "Poland", "goalsA": 0, "teamB": "Argentina", "goalsB": 2}, {"year": 2022, "phase": "group", "teamA": "Croatia", "goalsA": 0, "teamB": "Belgium", "goalsB": 0}, {"year": 2022, "phase": "group", "teamA": "Canada", "goalsA": 1, "teamB": "Morocco", "goalsB": 2}, {"year": 2022, "phase": "group", "teamA": "Japan", "goalsA": 2, "teamB": "Spain", "goalsB": 1}, {"year": 2022, "phase": "group", "teamA": "Costa Rica", "goalsA": 2, "teamB": "Germany", "goalsB": 4}, {"year": 2022, "phase": "group", "teamA": "South Korea", "goalsA": 2, "teamB": "Portugal", "goalsB": 1}, {"year": 2022, "phase": "group", "teamA": "Ghana", "goalsA": 0, "teamB": "Uruguay", "goalsB": 2}, {"year": 2022, "phase": "group", "teamA": "Cameroon", "goalsA": 1, "teamB": "Brazil", "goalsB": 0}, {"year": 2022, "phase": "group", "teamA": "Serbia", "goalsA": 2, "teamB": "Switzerland", "goalsB": 3}, {"year": 2022, "phase": "r16", "teamA": "Netherlands", "goalsA": 3, "teamB": "United States", "goalsB": 1}, {"year": 2022, "phase": "r16", "teamA": "Argentina", "goalsA": 2, "teamB": "Australia", "goalsB": 1}, {"year": 2022, "phase": "r16", "teamA": "France", "goalsA": 3, "teamB": "Poland", "goalsB": 1}, {"year": 2022, "phase": "r16", "teamA": "England", "goalsA": 3, "teamB": "Senegal", "goalsB": 0}, {"year": 2022, "phase": "r16", "teamA": "Japan", "goalsA": 1, "teamB": "Croatia", "goalsB": 1}, {"year": 2022, "phase": "r16", "teamA": "Brazil", "goalsA": 4, "teamB": "South Korea", "goalsB": 1}, {"year": 2022, "phase": "r16", "teamA": "Morocco", "goalsA": 0, "teamB": "Spain", "goalsB": 0}, {"year": 2022, "phase": "r16", "teamA": "Portugal", "goalsA": 6, "teamB": "Switzerland", "goalsB": 1}, {"year": 2022, "phase": "qf", "teamA": "Croatia", "goalsA": 1, "teamB": "Brazil", "goalsB": 1}, {"year": 2022, "phase": "qf", "teamA": "Netherlands", "goalsA": 2, "teamB": "Argentina", "goalsB": 2}, {"year": 2022, "phase": "qf", "teamA": "Morocco", "goalsA": 1, "teamB": "Portugal", "goalsB": 0}, {"year": 2022, "phase": "qf", "teamA": "England", "goalsA": 1, "teamB": "France", "goalsB": 2}, {"year": 2022, "phase": "sf", "teamA": "Argentina", "goalsA": 3, "teamB": "Croatia", "goalsB": 0}, {"year": 2022, "phase": "sf", "teamA": "France", "goalsA": 2, "teamB": "Morocco", "goalsB": 0}, {"year": 2022, "phase": "3rd", "teamA": "Croatia", "goalsA": 2, "teamB": "Morocco", "goalsB": 1}, {"year": 2022, "phase": "final", "teamA": "Argentina", "goalsA": 3, "teamB": "France", "goalsB": 3}];

let ranked=[], history=[], editions=[], allTeamsSorted=[];
let statsChart=null, compareChart=null;
const COLOR_A="#f59e0b", COLOR_B="#60a5fa";

function computeElo(matches) {
  const elo={}, matchCount={}, hist=[];
  function get(t){if(!(t in elo))elo[t]=INITIAL_ELO;return elo[t];}
  for(const m of matches){
    const ph=PHASES[m.phase]; if(!ph) continue;
    const rA=get(m.teamA),rB=get(m.teamB);
    const eA=1/(1+Math.pow(10,(rB-rA)/400));
    const sA=m.goalsA>m.goalsB?1:m.goalsA===m.goalsB?.5:0;
    const dA=Math.round(ph.k*(sA-eA));
    const bA=rA,bB=rB;
    elo[m.teamA]=rA+dA; elo[m.teamB]=rB-dA;
    matchCount[m.teamA]=(matchCount[m.teamA]||0)+1;
    matchCount[m.teamB]=(matchCount[m.teamB]||0)+1;
    hist.push({...m,before:{[m.teamA]:bA,[m.teamB]:bB},after:{[m.teamA]:elo[m.teamA],[m.teamB]:elo[m.teamB]}});
  }
  const r=Object.entries(elo).map(([team,e])=>{return{team,elo:Math.round(e),matches:matchCount[team]||0};} ).sort((a,b)=>b.elo-a.elo);
  return{ranked:r,history:hist};
}

function initApp(matches) {
  const result=computeElo(matches);
  ranked=result.ranked; history=result.history;
  editions=[...new Set(matches.map(m=>m.year))].sort();
  allTeamsSorted=ranked.map(r=>r.team).sort((a,b)=>a.localeCompare(b));

  document.getElementById("stat-editions").textContent=editions.length;
  document.getElementById("stat-matches").textContent=matches.length.toLocaleString();
  document.getElementById("stat-teams").textContent=ranked.length;
  document.getElementById("hero-sub").textContent="1930 – 2022  ·  "+editions.length+" editions  ·  "+ranked.length+" teams ranked";

  const selYear=document.getElementById("hist-year-filter");
  selYear.innerHTML='<option value="">All years</option>';
  [...editions].reverse().forEach(y=>{const o=document.createElement("option");o.value=y;o.textContent=y;selYear.appendChild(o);});

  ["hist-team-filter","stats-team-select","compare-team-a","compare-team-b"].forEach(id=>{
    const sel=document.getElementById(id);
    const first=sel.options[0].outerHTML;
    sel.innerHTML=first;
    allTeamsSorted.forEach(t=>{const o=document.createElement("option");o.value=t;o.textContent=t;sel.appendChild(o);});
  });

  const dl=document.getElementById("adm-teams-list");
  allTeamsSorted.forEach(t=>{const o=document.createElement("option");o.value=t;dl.appendChild(o);});
  document.getElementById("adm-year").value=2026;

  buildRegionChips();
  renderRanking();
  renderHistory();
}

// Load from server, fall back to embedded BASE_MATCHES
async function loadAndRender() {
  const paths=['matches.json','./matches.json','/worldcup/matches.json'];
  let loaded=false;
  for(const path of paths){
    try{
      const resp=await fetch(path+'?v='+Date.now());
      if(!resp.ok) continue;
      const matches=await resp.json();
      initApp(matches); loaded=true; break;
    }catch(e){}
  }
  if(!loaded){
    // Fallback to embedded data
    initApp(BASE_MATCHES);
  }
}

function eloColorHex(e){
  if(e>=1750)return"#f59e0b"; if(e>=1700)return"#f97316";
  if(e>=1650)return"#60a5fa"; if(e>=1600)return"#4ade80";
  return"#f87171";
}

// Region chips
let activeRegion="";
function buildRegionChips(){
  const allRegions=[...new Set(ranked.map(r=>(TEAM_INFO[r.team]||{}).region).filter(Boolean))].sort();
  const wrap=document.getElementById("region-filters");
  wrap.innerHTML="";
  function makeChip(label,region){
    const btn=document.createElement("button");
    btn.className="region-chip"+(region===""?" active":"");
    btn.dataset.region=region;
    btn.textContent=label;
    btn.onclick=()=>{
      activeRegion=region;
      wrap.querySelectorAll(".region-chip").forEach(c=>c.classList.remove("active"));
      btn.classList.add("active");
      renderRanking();
    };
    return btn;
  }
  wrap.appendChild(makeChip("ALL",""));
  allRegions.forEach(r=>wrap.appendChild(makeChip(r,r)));
}

function renderRanking(){
  const container=document.getElementById("ranking-table");
  container.innerHTML="";
  const toShow=activeRegion?ranked.filter(r=>(TEAM_INFO[r.team]||{}).region===activeRegion):ranked;
  if(!toShow.length){container.innerHTML='<div class="empty">NO TEAMS FOUND</div>';return;}
  const globalRank={};ranked.forEach((r,i)=>globalRank[r.team]=i+1);
  const maxElo=toShow[0].elo,minElo=toShow[toShow.length-1].elo;
  toShow.forEach((item,i)=>{
    const info=TEAM_INFO[item.team]||{};
    const region=info.region||"";
    const rcol=REGION_COLORS[region]||"#4a5568";
    const delta=item.elo-INITIAL_ELO;
    const col=eloColorHex(item.elo);
    const barPct=maxElo===minElo?100:Math.max(0,((item.elo-minElo)/(maxElo-minElo))*100);
    const pos=activeRegion?globalRank[item.team]:i+1;
    const rowClass=i===0&&!activeRegion?"rank-row top1":i<3&&!activeRegion?"rank-row top3":"rank-row";
    let medal;
    if(!activeRegion&&i===0) medal=`<span class="rank-badge medal-1">${pos}</span>`;
    else if(!activeRegion&&i===1) medal=`<span class="rank-badge medal-2">${pos}</span>`;
    else if(!activeRegion&&i===2) medal=`<span class="rank-badge medal-3">${pos}</span>`;
    else medal=`<span class="rank-badge medal-n">${pos}</span>`;
    const row=document.createElement("div");
    row.className=rowClass; row.style.cursor="pointer";
    row.title="View history for "+item.team;
    row.addEventListener("click",()=>{
      document.getElementById("hist-team-filter").value=item.team;
      document.getElementById("hist-year-filter").value="";
      document.getElementById("stats-team-select").value=item.team;
      renderHistory(); renderStats();
      switchTab("history",document.querySelector('.tab-btn[onclick*="history"]'));
    });
    row.innerHTML=
      medal+
      `<span class="rank-badge" style="background:${rcol}22;color:${rcol};border:1px solid ${rcol}44">${region}</span>`+
      `<div><div class="rank-name">${item.team}</div>${!activeRegion?`<div class="rank-region-name">${info.label||""}</div>`:""}</div>`+
      `<span class="rank-elo" style="color:${col}">${item.elo}</span>`+
      `<span class="rank-delta" style="color:${delta>=0?"#4ade80":"#f87171"}">${delta>=0?"+":""}${delta}</span>`+
      `<div class="rank-bar-wrap"><div class="rank-bar" style="width:${barPct}%;background:${col}"></div></div>`+
      `<span class="rank-matches">${item.matches}</span>`;
    container.appendChild(row);
  });
}

function renderHistory(){
  const teamVal=document.getElementById("hist-team-filter").value;
  const yearVal=document.getElementById("hist-year-filter").value;
  const container=document.getElementById("hist-list");
  container.innerHTML="";
  let filtered=history;
  if(yearVal) filtered=filtered.filter(m=>String(m.year)===yearVal);
  if(teamVal) filtered=filtered.filter(m=>m.teamA===teamVal||m.teamB===teamVal);
  if(!filtered.length){container.innerHTML='<div class="empty">NO MATCHES FOUND</div>';return;}
  const grouped={};
  [...filtered].reverse().forEach(m=>{(grouped[m.year]=grouped[m.year]||[]).push(m);});
  Object.keys(grouped).sort((a,b)=>b-a).forEach(y=>{
    const div=document.createElement("div");div.className="season-divider";div.textContent=y+" FIFA World Cup";container.appendChild(div);
    grouped[y].forEach(m=>{
      const ph=PHASES[m.phase]||{label:m.phase,color:"#666"};
      const dA=m.after[m.teamA]-m.before[m.teamA],dB=m.after[m.teamB]-m.before[m.teamB];
      const clA=m.goalsA>m.goalsB?"win":m.goalsA===m.goalsB?"draw":"loss";
      const clB=m.goalsB>m.goalsA?"win":m.goalsA===m.goalsB?"draw":"loss";
      const iA=TEAM_INFO[m.teamA]||{},iB=TEAM_INFO[m.teamB]||{};
      const cA=REGION_COLORS[iA.region]||"#4a5568",cB=REGION_COLORS[iB.region]||"#4a5568";
      const row=document.createElement("div");row.className="hist-row";
      row.innerHTML=
        `<div><span class="badge" style="background:${ph.color}1a;color:${ph.color}">${ph.label}</span></div>`+
        `<div class="hist-team"><div class="hist-team-name"><span class="rank-badge" style="font-size:8px;padding:2px 5px;background:${cA}22;color:${cA};border:1px solid ${cA}44">${iA.region||"·"}</span><span class="${clA}">${m.teamA}</span></div><span class="hist-elo-diff">${dA>=0?"+":""}${dA} (${m.after[m.teamA]})</span></div>`+
        `<div class="hist-score">${m.goalsA} – ${m.goalsB}</div>`+
        `<div class="hist-team"><div class="hist-team-name"><span class="rank-badge" style="font-size:8px;padding:2px 5px;background:${cB}22;color:${cB};border:1px solid ${cB}44">${iB.region||"·"}</span><span class="${clB}">${m.teamB}</span></div><span class="hist-elo-diff">${dB>=0?"+":""}${dB} (${m.after[m.teamB]})</span></div>`;
      container.appendChild(row);
    });
  });
}

function renderStats(){
  const team=document.getElementById("stats-team-select").value;
  const emptyEl=document.getElementById("stats-empty");
  const chartWrap=document.getElementById("stats-chart-wrap");
  const gridEl=document.getElementById("stats-season-grid");
  const infoEl=document.getElementById("stats-team-info");
  if(!team){emptyEl.style.display="block";chartWrap.style.display="none";gridEl.style.display="none";infoEl.textContent="";return;}
  emptyEl.style.display="none";
  const timeline=[];
  history.forEach(m=>{
    if(m.teamA===team||m.teamB===team){
      const isA=m.teamA===team;
      timeline.push({elo:isA?m.after[m.teamA]:m.after[m.teamB],year:m.year,phase:m.phase,phaseLabel:(PHASES[m.phase]||{}).label||m.phase,opponent:isA?m.teamB:m.teamA});
    }
  });
  if(!timeline.length){emptyEl.textContent="NO DATA FOR "+team.toUpperCase();emptyEl.style.display="block";chartWrap.style.display="none";gridEl.style.display="none";return;}
  const peakElo=Math.max(...timeline.map(t=>t.elo));
  const peakIdx=timeline.findIndex(t=>t.elo===peakElo);
  const peakYear=timeline[peakIdx]?.year||"";
  const curElo=timeline[timeline.length-1].elo;
  const globalPos=ranked.findIndex(r=>r.team===team)+1;
  const info=TEAM_INFO[team]||{};
  infoEl.innerHTML=`<span style="color:#f59e0b;font-weight:700">#${globalPos}</span> &nbsp;${info.label||""} &nbsp;·&nbsp; <span style="color:${eloColorHex(curElo)}">${curElo} ELO</span> &nbsp;·&nbsp; ${timeline.length} matches`;
  chartWrap.style.display="block";
  const labels=timeline.map((t,i)=>{if(i===0)return String(t.year);if(timeline[i-1].year!==t.year)return String(t.year);return"";});
  const ctx=document.getElementById("stats-chart").getContext("2d");
  const grad=ctx.createLinearGradient(0,0,0,300);
  grad.addColorStop(0,"rgba(245,158,11,0.25)");grad.addColorStop(1,"rgba(245,158,11,0.01)");
  if(statsChart){statsChart.destroy();statsChart=null;}
  statsChart=new Chart(ctx,{type:"line",data:{labels,datasets:[{label:team,data:timeline.map(t=>t.elo),borderColor:COLOR_A,borderWidth:2,pointRadius:0,pointHoverRadius:5,pointHoverBackgroundColor:COLOR_A,fill:true,backgroundColor:grad,tension:0.3},{label:"Base",data:timeline.map(()=>1600),borderColor:"rgba(255,255,255,0.08)",borderWidth:1,borderDash:[4,4],pointRadius:0,fill:false}]},options:{responsive:true,maintainAspectRatio:true,interaction:{mode:"index",intersect:false},plugins:{legend:{display:false},tooltip:{backgroundColor:"#0f1017",borderColor:"#1a1c2e",borderWidth:1,titleColor:COLOR_A,bodyColor:"#94a3b8",titleFont:{family:"'DM Mono',monospace",size:11},bodyFont:{family:"'DM Mono',monospace",size:11},callbacks:{title:items=>{const t=timeline[items[0].dataIndex];return t.year+" · "+t.phaseLabel;},label:item=>item.datasetIndex===1?null:" ELO: "+item.raw+"  vs "+timeline[item.dataIndex].opponent}}},scales:{x:{ticks:{color:"#4a5568",font:{family:"'DM Mono',monospace",size:9},maxRotation:45,autoSkip:true,maxTicksLimit:25},grid:{color:"rgba(255,255,255,0.04)"},border:{color:"rgba(255,255,255,0.08)"}},y:{ticks:{color:"#4a5568",font:{family:"'DM Mono',monospace",size:10}},grid:{color:"rgba(255,255,255,0.04)"},border:{color:"rgba(255,255,255,0.08)"}}}}});
  gridEl.style.display="grid";gridEl.innerHTML="";
  const banner=document.createElement("div");banner.className="stats-peak-banner";banner.style.gridColumn="1 / -1";
  banner.innerHTML=`Highest ELO Rating: <span class="stats-peak-val">${peakElo}</span> &nbsp;in <span style="color:#e2e8f0">${peakYear}</span> &nbsp;·&nbsp; Current: <span class="stats-peak-val" style="color:${eloColorHex(curElo)}">${curElo}</span> &nbsp;·&nbsp; Matches: <span style="color:#e2e8f0">${timeline.length}</span>`;
  gridEl.appendChild(banner);
  const seasonStats={},seasonOrder=[];let prev=1600;
  timeline.forEach(t=>{if(!seasonStats[t.year]){seasonStats[t.year]={startElo:prev,endElo:t.elo,matches:0};seasonOrder.push(t.year);}seasonStats[t.year].endElo=t.elo;seasonStats[t.year].matches++;prev=t.elo;});
  seasonOrder.forEach(y=>{seasonStats[y].delta=seasonStats[y].endElo-seasonStats[y].startElo;});
  const allEnd=Object.values(seasonStats).map(s=>s.endElo);
  const maxSE=Math.max(...allEnd),minSE=Math.min(...allEnd);
  seasonOrder.forEach(y=>{
    const sv=seasonStats[y];const col=eloColorHex(sv.endElo);
    const barPct=maxSE===minSE?100:Math.max(5,((sv.endElo-minSE)/(maxSE-minSE))*100);
    const card=document.createElement("div");card.className="stats-season-card";
    card.innerHTML=`<span class="stats-season-label">${y}</span><span class="stats-season-elo" style="color:${col}">${sv.endElo}</span><span class="stats-season-delta" style="color:${sv.delta>=0?"#4ade80":"#f87171"}">${sv.delta>=0?"+":""}${sv.delta}</span><div class="stats-season-bar-wrap"><div class="stats-season-bar" style="width:${barPct}%;background:${col}"></div></div><span class="stats-season-matches">${sv.matches}m</span>`;
    gridEl.appendChild(card);
  });
}

function getTeamTimeline(team){const tl=[];history.forEach(m=>{if(m.teamA===team||m.teamB===team){const isA=m.teamA===team;tl.push({elo:isA?m.after[m.teamA]:m.after[m.teamB],year:m.year,opponent:isA?m.teamB:m.teamA});}});return tl;}
function getEditionElos(tl){const result={},order=[];let prev=1600;tl.forEach(t=>{if(!result[t.year]){result[t.year]={startElo:prev,endElo:t.elo,matches:0};order.push(t.year);}result[t.year].endElo=t.elo;result[t.year].matches++;prev=t.elo;});order.forEach(y=>{result[y].delta=result[y].endElo-result[y].startElo;});return{bySeason:result,order};}

function renderCompare(){
  const teamA=document.getElementById("compare-team-a").value;
  const teamB=document.getElementById("compare-team-b").value;
  const emptyEl=document.getElementById("compare-empty");
  const chartWrap=document.getElementById("compare-chart-wrap");
  const tableEl=document.getElementById("compare-season-table");
  const badgesEl=document.getElementById("compare-badges");
  if(!teamA||!teamB||teamA===teamB){emptyEl.style.display="block";chartWrap.style.display="none";tableEl.innerHTML="";badgesEl.innerHTML="";emptyEl.textContent=(!teamA||!teamB)?"SELECT TWO TEAMS TO COMPARE":"PLEASE SELECT TWO DIFFERENT TEAMS";return;}
  emptyEl.style.display="none";
  const tlA=getTeamTimeline(teamA),tlB=getTeamTimeline(teamB);
  if(!tlA.length||!tlB.length){emptyEl.textContent="NO DATA AVAILABLE";emptyEl.style.display="block";return;}
  const iA=TEAM_INFO[teamA]||{},iB=TEAM_INFO[teamB]||{};
  const curEloA=tlA[tlA.length-1].elo,curEloB=tlB[tlB.length-1].elo;
  const peakA=Math.max(...tlA.map(t=>t.elo)),peakB=Math.max(...tlB.map(t=>t.elo));
  const rankA=ranked.findIndex(r=>r.team===teamA)+1,rankB=ranked.findIndex(r=>r.team===teamB)+1;
  const cA=REGION_COLORS[iA.region]||COLOR_A,cB=REGION_COLORS[iB.region]||COLOR_B;
  badgesEl.innerHTML=`<div class="compare-badges-row"><div class="compare-badge" style="background:${cA}15;border:1px solid ${cA}40;color:${cA}"><span style="font-size:16px;font-family:'Bebas Neue',sans-serif;letter-spacing:2px">${teamA}</span><span style="color:#94a3b8">#${rankA} · ${iA.label||""} · ELO ${curEloA} · Peak ${peakA}</span></div><div class="compare-badge" style="background:${cB}15;border:1px solid ${cB}40;color:${cB}"><span style="font-size:16px;font-family:'Bebas Neue',sans-serif;letter-spacing:2px">${teamB}</span><span style="color:#94a3b8">#${rankB} · ${iB.label||""} · ELO ${curEloB} · Peak ${peakB}</span></div></div>`;
  const {bySeason:bsA}=getEditionElos(tlA),{bySeason:bsB}=getEditionElos(tlB);
  const allYears=editions.filter(y=>bsA[y]||bsB[y]);
  const dataA=allYears.map(y=>bsA[y]?bsA[y].endElo:null);
  const dataB=allYears.map(y=>bsB[y]?bsB[y].endElo:null);
  chartWrap.style.display="block";
  const ctx2=document.getElementById("compare-chart").getContext("2d");
  const gradA=ctx2.createLinearGradient(0,0,0,300);gradA.addColorStop(0,cA+"40");gradA.addColorStop(1,cA+"04");
  const gradB=ctx2.createLinearGradient(0,0,0,300);gradB.addColorStop(0,cB+"40");gradB.addColorStop(1,cB+"04");
  if(compareChart){compareChart.destroy();compareChart=null;}
  compareChart=new Chart(ctx2,{type:"line",data:{labels:allYears.map(String),datasets:[{label:teamA,data:dataA,borderColor:cA,borderWidth:2.5,backgroundColor:gradA,fill:true,tension:0.3,pointRadius:3,pointBackgroundColor:cA,pointHoverRadius:6,spanGaps:true},{label:teamB,data:dataB,borderColor:cB,borderWidth:2.5,backgroundColor:gradB,fill:true,tension:0.3,pointRadius:3,pointBackgroundColor:cB,pointHoverRadius:6,spanGaps:true},{label:"Base",data:allYears.map(()=>1600),borderColor:"rgba(255,255,255,0.07)",borderWidth:1,borderDash:[4,4],pointRadius:0,fill:false}]},options:{responsive:true,maintainAspectRatio:true,interaction:{mode:"index",intersect:false},plugins:{legend:{display:true,labels:{color:"#94a3b8",font:{family:"'DM Mono',monospace",size:11},boxWidth:16,padding:16,filter:item=>item.label!=="Base"}},tooltip:{backgroundColor:"#0f1017",borderColor:"#1a1c2e",borderWidth:1,titleColor:COLOR_A,bodyColor:"#94a3b8",titleFont:{family:"'DM Mono',monospace",size:11},bodyFont:{family:"'DM Mono',monospace",size:11},callbacks:{label:item=>item.dataset.label==="Base"?null:` ${item.dataset.label}: ${item.raw} ELO`}}},scales:{x:{ticks:{color:"#4a5568",font:{family:"'DM Mono',monospace",size:9},maxRotation:45},grid:{color:"rgba(255,255,255,0.04)"},border:{color:"rgba(255,255,255,0.08)"}},y:{ticks:{color:"#4a5568",font:{family:"'DM Mono',monospace",size:10}},grid:{color:"rgba(255,255,255,0.04)"},border:{color:"rgba(255,255,255,0.08)"}}}}});
  let tableHTML=`<div style="border:1px solid #1a1c2e;border-radius:4px;overflow:hidden;"><table class="compare-table"><thead><tr><th style="text-align:left">Year</th><th style="text-align:center;color:${cA}">${teamA}</th><th style="text-align:center;color:${cA}">Δ</th><th style="text-align:center;color:${cB}">${teamB}</th><th style="text-align:center;color:${cB}">Δ</th><th style="text-align:center">Higher Ranked</th></tr></thead><tbody>`;
  allYears.forEach(y=>{
    const a=bsA[y],b=bsB[y];
    const eloA=a?a.endElo:null,eloB=b?b.endElo:null;
    const dA=a?a.delta:null,dB=b?b.delta:null;
    const leader=eloA&&eloB?(eloA>eloB?teamA.split(" ")[0]:eloA<eloB?teamB.split(" ")[0]:"="):"—";
    const leaderCol=eloA&&eloB?(eloA>eloB?cA:eloA<eloB?cB:"#4a5568"):"#4a5568";
    const cellA=eloA?`<span style="color:${eloColorHex(eloA)};font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:1px">${eloA}</span>`:`<span style="color:#2a2d3e">—</span>`;
    const cellB=eloB?`<span style="color:${eloColorHex(eloB)};font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:1px">${eloB}</span>`:`<span style="color:#2a2d3e">—</span>`;
    const dCellA=dA!==null?`<span style="color:${dA>=0?"#4ade80":"#f87171"}">${dA>=0?"+":""}${dA}</span>`:`<span style="color:#2a2d3e">—</span>`;
    const dCellB=dB!==null?`<span style="color:${dB>=0?"#4ade80":"#f87171"}">${dB>=0?"+":""}${dB}</span>`:`<span style="color:#2a2d3e">—</span>`;
    tableHTML+=`<tr><td class="season-col">${y}</td><td style="text-align:center">${cellA}</td><td style="text-align:center">${dCellA}</td><td style="text-align:center">${cellB}</td><td style="text-align:center">${dCellB}</td><td style="text-align:center;color:${leaderCol};font-weight:600">${leader}</td></tr>`;
  });
  tableHTML+="</tbody></table></div>";
  tableEl.innerHTML=tableHTML;
}

function toggleAdmin(){
  const p=document.getElementById("admin-panel");
  const opening=p.style.display==="none"||p.style.display==="";
  p.style.display=opening?"block":"none";
  if(opening) adminLoadRecent();
}

async function adminAddMatch(){
  const msg=document.getElementById("admin-msg");
  const goalsARaw=document.getElementById("adm-goalsA").value;
  const goalsBRaw=document.getElementById("adm-goalsB").value;
  const body={
    password:document.getElementById("adm-pass").value,
    year:parseInt(document.getElementById("adm-year").value)||0,
    phase:document.getElementById("adm-phase").value,
    teamA:document.getElementById("adm-teamA").value.trim(),
    goalsA:goalsARaw===""?"":parseInt(goalsARaw,10),
    teamB:document.getElementById("adm-teamB").value.trim(),
    goalsB:goalsBRaw===""?"":parseInt(goalsBRaw,10),
  };
  if(!body.teamA||!body.teamB||goalsARaw===""||goalsBRaw===""||!body.year){
    msg.className="err";msg.textContent="Fill in all fields.";msg.style.display="block";return;
  }
  msg.className="";msg.textContent="Saving…";msg.style.display="block";
  try{
    const r=await fetch("save_match.php",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
    const data=await r.json();
    if(!r.ok){msg.className="err";msg.textContent="Error: "+data.error;return;}
    msg.className="ok";msg.textContent="✓ Saved! Total: "+data.total+". Reloading…";
    setTimeout(()=>loadAndRender(),1200);
  }catch(e){msg.className="err";msg.textContent="Network error: "+e.message;}
}

async function adminLoadRecent(){
  const container=document.getElementById("admin-recent");
  container.innerHTML='<span style="color:#4a5568">Loading…</span>';
  try{
    const paths=['matches.json','./matches.json','/worldcup/matches.json'];
    let matches=null;
    for(const path of paths){
      try{const r=await fetch(path+'?v='+Date.now());if(r.ok){matches=await r.json();break;}}catch(e){}
    }
    if(!matches){matches=BASE_MATCHES;}
    const recent=matches.slice(-20).reverse();
    if(!recent.length){container.textContent="No matches found.";return;}
    const PH={group:"GR",r16:"R16",qf:"QF",sf:"SF","3rd":"3rd",final:"FIN"};
    container.innerHTML="";
    recent.forEach((m,i)=>{
      const globalIdx=matches.length-1-i;
      const row=document.createElement("div");
      row.style.cssText="display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid #111320;";
      row.innerHTML=
        `<span style="color:#f59e0b;min-width:42px;font-size:10px">${m.year}</span>`+
        `<span style="background:#60a5fa1a;color:#60a5fa;padding:2px 5px;border-radius:2px;font-size:9px;min-width:28px;text-align:center">${PH[m.phase]||m.phase}</span>`+
        `<span style="flex:1;color:#e2e8f0">${m.teamA} <span style="color:#4a5568">${m.goalsA}–${m.goalsB}</span> ${m.teamB}</span>`+
        `<button onclick="adminDelete(${globalIdx},this)" style="background:none;border:1px solid #2a2d3e;color:#4a5568;font-family:'DM Mono',monospace;font-size:10px;padding:3px 8px;cursor:pointer;border-radius:3px;" onmouseover="this.style.borderColor='#ef4444';this.style.color='#ef4444'" onmouseout="this.style.borderColor='#2a2d3e';this.style.color='#4a5568'">✕</button>`;
      container.appendChild(row);
    });
  }catch(e){container.textContent="Error: "+e.message;}
}

async function adminDelete(index,btn){
  const pass=document.getElementById("adm-pass").value;
  if(!pass){alert("Enter password first.");return;}
  if(!confirm("Delete this match?"))return;
  btn.textContent="…";btn.disabled=true;
  try{
    const r=await fetch("save_match.php",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({password:pass,action:"delete",index})});
    const data=await r.json();
    if(!r.ok){alert("Error: "+data.error);btn.textContent="✕";btn.disabled=false;return;}
    const msg=document.getElementById("admin-msg");
    msg.className="ok";msg.textContent="✓ Deleted. Total: "+data.total;msg.style.display="block";
    btn.closest("div").remove();
    setTimeout(()=>loadAndRender(),800);
  }catch(e){alert("Network error: "+e.message);btn.textContent="✕";btn.disabled=false;}
}

function switchTab(name,btn){
  document.querySelectorAll(".panel").forEach(p=>p.classList.remove("active"));
  document.querySelectorAll(".tab-btn").forEach(b=>b.classList.remove("active"));
  document.getElementById("panel-"+name).classList.add("active");
  if(btn) btn.classList.add("active");
}

loadAndRender();
</script>
</body>
</html>